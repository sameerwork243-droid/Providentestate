{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/in-sea-cliff-residences","result":{"serverData":{"data":{"status":true,"hits":[{"rank":null,"slug":"sea-cliff-residences-imtiaz-developments-dubai-islands","about":"Sea Cliff by Imtiaz Developments is a premium waterfront residential development located on the Dubai Islands. Designed as an ocean-inspired address, Sea Cliff combines contemporary architecture with panoramic sea views. The building features a balanced mid-rise structure that maximizes open views while maintaining privacy and exclusivity within a coastal setting.The project comprises 170 residences, including 1 to 3-bedroom apartments and a limited collection of 4-bedroom duplexes. Select duplex units include private pools, providing an elevated level of privacy. Residents benefit from a comprehensive amenity offering, including a swimming pool, kids' pool, clubhouse, gym, and landscaped seating areas. Positioned within Dubai’s 2040 Urban Master Plan and D33 Economic Agenda framework, the project is located in a dynamic waterfront community directly connected to the mainland via established bridges and major road networks.","price":1900000,"title":"Sea Cliff Residences","bitrix":{"id":1459,"pf_id":null,"source":null,"project_id":null,"tower_name":null,"campaign_name":"Sea Cliff Residences","property_type":"Apartment","developer_name":"Imtiaz Developments","project_location":" Dubai Islands"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Feature_73d7687758.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Feature_73d7687758.webp"}],"status":null,"_geoloc":{"lat":25.292639381169,"lng":55.307835971156},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Gallery_12_0102d614f7.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Gallery_12_0102d614f7.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Gallery_3_46393a0c78.web