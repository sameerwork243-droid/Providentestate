 appeal, guaranteeing a stable income. The average ROI for a 1 bedroom residence in Riverside Crescent is &gt; 6.3% with an average rental value of AED 95 000 per year.","price":1579464,"title":"360 Riverside Crescent","bitrix":{"id":456,"pf_id":"are.3.13319","source":null,"project_id":"Sobha Hartland II","tower_name":null,"campaign_name":"Sobha General","property_type":"Apartment","developer_name":"Sobha Realty","project_location":"Bukadra"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/340x252/gmGeJZXWDcqUixssHMyOltEP8aTexfBUVyQLj8FA.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/464x312/gmGeJZXWDcqUixssHMyOltEP8aTexfBUVyQLj8FA.webp"}],"status":"pending","_geoloc":{"lat":25.1768153,"lng":55.3253325},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/340x252/cDQ3usSO8SHS06mvn3JJWG9JdwsIcrWuVQ6FNd9t.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/464x312/cDQ3usSO8SHS06mvn3JJWG9JdwsIcrWuVQ6FNd9t.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/340x252/YBt2D59lgYij7IbLo04HXdl3PhhCoDaeJL17aA6u.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/464x312/YBt2D59lgYij7IbLo04HXdl3PhhCoDaeJL17aA6u.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/340x252/gmGeJZXWDcqUixssHMyOltEP8aTexfBUVyQLj8FA.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/464x312/gmGeJZXWDcqUixssHMyOltEP8aTexfBUVyQLj8FA.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/340x252/cDQ3usSO8SHS06mvn3JJWG9JdwsIcrWuVQ6FNd9t.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/572/images/2023/11/28/464x312/cDQ3usSO8SHS06mvn3JJWG9JdwsIcrWuVQ6FNd9t.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-