 those looking for luxurious yet comfortable living. This project offers unrivaled quality, value for money and a unique lifestyle.","price":822530,"title":"Beach Oasis","bitrix":{"id":579,"pf_id":null,"source":null,"project_id":"Azizi Projects","tower_name":null,"campaign_name":"Azizi Projects","property_type":"Apartment","developer_name":"Azizi Developments","project_location":"Studio City"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/FjYwMEDEaty3a6zvhd8e0rYLue6MaotRJolFZeH1.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/464x312/FjYwMEDEaty3a6zvhd8e0rYLue6MaotRJolFZeH1.webp"}],"status":"ready","_geoloc":{"lat":25.0369337,"lng":55.2354478},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/fo6fHpKvFgBPYkU4HqCHD8LzvDEHKDXjyAUu2nNU.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/464x312/fo6fHpKvFgBPYkU4HqCHD8LzvDEHKDXjyAUu2nNU.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/eH5UTG0dZZWKMzmiNmIm1rIxAYKI2sFYdgoIMNEC.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/464x312/eH5UTG0dZZWKMzmiNmIm1rIxAYKI2sFYdgoIMNEC.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/FjYwMEDEaty3a6zvhd8e0rYLue6MaotRJolFZeH1.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/464x312/FjYwMEDEaty3a6zvhd8e0rYLue6MaotRJolFZeH1.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/fo6fHpKvFgBPYkU4HqCHD8LzvDEHKDXjyAUu2nNU.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/464x312/fo6fHpKvFgBPYkU4HqCHD8LzvDEHKDXjyAUu2nNU.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/11/images/2023/6/6/340x252/eH5UTG0dZZWKMzmiNmIm1rIxAYKI2sFYdgoIMNEC.webp","46