{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/in-al-habtoor-polo-resort-club","result":{"serverData":{"data":{"status":true,"hits":[{"rank":null,"slug":"al-habtoor-polo-resort-and-club-dubailand","about":"Al Habtoor Polo Resort &amp; Club is a prestigious equestrian community in the heart of DubaiLand, offering an unparalleled blend of luxury and the elite sport of polo. Spanning an impressive 6 million square feet, this meticulously designed development features four international-standard polo fields, a state-of-the-art riding school, and 500 stables. Al Habtoor Polo Resort comprises 147 exquisitely crafted villas, including 3 to 6-bedroom semi-detached and standalone residences, each offering  breathtaking views of lush landscapes and top-tier polo facilities. Beyond its world-class residences, Al Habtoor Polo Resort, Dubai also boasts a 151-key luxury Andalusian-style hotel and 25 resort-branded homes, making it a distinctive destination for discerning investors and equestrian enthusiasts alike. With its prime location, this one-of-a-kind development offers an unparalleled blend of convenience, prestige, and an elite sporting lifestyle.","price":4700000,"title":"Al Habtoor Polo Resort & Club","bitrix":{"id":1144,"pf_id":null,"source":null,"project_id":"Al Habtoor Polo Resort and Club - The Residences","tower_name":null,"campaign_name":"Al Habtoor Polo Resort and Club","property_type":"Villas","developer_name":"Habtoor Group","project_location":"Dubailand"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/feature_b9001bf9b2.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/feature_b9001bf9b2.webp"}],"status":"ready","_geoloc":{"lat":25.0901987,"lng":55.3785795},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Al_Tay_Hills_in_Sharjah_Villas_and_Mansions_e46e8c8516.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Al_Tay_Hills_in_Sharjah_V