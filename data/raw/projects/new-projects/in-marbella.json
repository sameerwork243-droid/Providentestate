joying the cool breeze of the environment. Take advantage of leisure facilities such as swimming to lift your spirits and the refreshing vibes of the natural elements, as well as the spa and other areas for relaxation, entertainment and wellness.","price":1950000,"title":"Marbella Villas","bitrix":{"id":826,"pf_id":null,"source":null,"project_id":"Marbella Villas","tower_name":null,"campaign_name":"Marbella Villas","property_type":"Villas","developer_name":"RAK Properties","project_location":"Mina Al Arab"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/340x252/QI8P7llV8t2J10kq8POL4vg13XgZEpOnKtnomPJv.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/464x312/QI8P7llV8t2J10kq8POL4vg13XgZEpOnKtnomPJv.webp"}],"status":"ready","_geoloc":{"lat":25.722229,"lng":55.8397452},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/340x252/JC6I4WGgblQr4KYaH4OWOVnwYOolNJaItmwhcnJa.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/464x312/JC6I4WGgblQr4KYaH4OWOVnwYOolNJaItmwhcnJa.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/340x252/QI8P7llV8t2J10kq8POL4vg13XgZEpOnKtnomPJv.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/464x312/QI8P7llV8t2J10kq8POL4vg13XgZEpOnKtnomPJv.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/340x252/JC6I4WGgblQr4KYaH4OWOVnwYOolNJaItmwhcnJa.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/253/images/2023/6/13/464x312/JC6I4WGgblQr4KYaH4OWOVnwYOolNJaItmwhcnJa.webp"}],"publish":true,"currency":"","features":["waterfront"],"objectID":1259,"amenities":["covered-parking","laundry","childrens-pool","kids-play-area","shared-gym-fitness","leisure-areas","spa"],"community":"mina-al-arab","developer":"rak-properties","video_url":null,"created_on":