ing. With flexible payment plans, Eden House Dubai Hills is an excellent investment for those seeking a refined living in a serene environment.","price":24400000,"title":"Eden House","bitrix":{"id":1017,"pf_id":"are.2.11264","source":null,"project_id":"Eden House","tower_name":null,"campaign_name":"Eden House Dubai Hills","property_type":"Villas","developer_name":"H&H Development","project_location":"Al Satwa"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_a9a21303f8.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_a9a21303f8.webp"}],"status":"pending","_geoloc":{"lat":25.1075354,"lng":55.2680353},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_141cbc1ca7.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_141cbc1ca7.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_4629014475.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_4629014475.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_fd1b52a006.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_fd1b52a006.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_a9a21303f8.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_a9a21303f8.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/Eden_House_Dubai_Hills_by_H_and_H_Development_141cbc1ca7.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/Eden_House_Dubai_Hills_by_H_and_H_Development_141cbc1ca7