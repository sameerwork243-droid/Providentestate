operties.","price":4053888,"title":"Creek Rise","bitrix":{"id":649,"pf_id":"are.2.9142","source":null,"project_id":"Creek Rise","tower_name":null,"campaign_name":"Creek Rise","property_type":"Apartment","developer_name":"Emaar Properties","project_location":"Dubai Creek Harbour (The Lagoons)"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/02/340x252/o0Lo1HROeps4eCkTTpaTJeJEGjUT6r4rhiZMfklX.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/02/464x312/o0Lo1HROeps4eCkTTpaTJeJEGjUT6r4rhiZMfklX.webp"}],"status":"pending","_geoloc":{"lat":25.2064181,"lng":55.3467655},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/340x252/gXaVWUX5HI46EaZrzMRPAubp9j7t3CRrWUPirxK1.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/464x312/gXaVWUX5HI46EaZrzMRPAubp9j7t3CRrWUPirxK1.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/340x252/nuFY2fJnKtR3yOVPcP5KaHoCjzBYPTCo3nc2tV30.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/464x312/nuFY2fJnKtR3yOVPcP5KaHoCjzBYPTCo3nc2tV30.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/340x252/LXVUEv6pE4Y3N7pDcqUoN1ltW5wCfis92hC1hSxJ.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/464x312/LXVUEv6pE4Y3N7pDcqUoN1ltW5wCfis92hC1hSxJ.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/02/340x252/o0Lo1HROeps4eCkTTpaTJeJEGjUT6r4rhiZMfklX.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/02/464x312/o0Lo1HROeps4eCkTTpaTJeJEGjUT6r4rhiZMfklX.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/2083/images/2024/06/01/340x252/gXaVWUX5HI46EaZrzMRPAubp9j7t3CRrWUPirxK1.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan