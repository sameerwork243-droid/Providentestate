_on":1737374970696,"search_type":"sales","max_bedrooms":5,"min_bedrooms":5,"search_areas":["sunrise-living","jumeirah-park","dubai"],"building_type":["villa"],"display_price":"8.93M","future_launch":false,"agent_category":"B","completion_year":"2025","display_address":"Jumeirah Park","display_bedrooms":null,"agent_segmentation":"Super Luxury"},{"rank":null,"slug":"sunrise-bay-emaar-beach-front","about":"Sunrise Bay is a coastal residential complex consisting of two 26-storey buildings. The project consists of two completely identical towers connected by a five-storey podium, inside which are located shopping center, stores, restaurants and recreation area with a swimming pool.The complex offers stylish apartments with 1-4 bedrooms, which offer spectacular views of the Arabian Gulf or the marina. The layouts of the residences are spacious and functional, the interior is made in loft style, there is a fully equipped kitchen, spacious bathroom, built-in closet, laundry room, open balcony, panoramic windows. Apartments with 2-4 bedrooms are complemented by walk-in closets.Residents have access to premium amenities: private beach, underground parking, 24-hour security, panoramic infinity pool, children's play area, equipped gym.The infrastructure of this neighborhood is carefully planned for permanent residence and convenient business. It will take less than 5 minutes by car to reach Dubai Marina. Within 10-15 minutes drive are Berlitz Private School, Raffles Nursery School, Marina Medical Center, Drs. Nicolas &amp; Asp. Residents have access to public transportation: monorail, buses and streetcars. A quick exit to Sheikh Zayed Road provides easy access to the main locations of Dubai.","price":6250000,"title":"Sunrise Bay","bitrix":{"id":432,"pf_id":"are.3.9798","source":null,"project_id":"EMAAR Beachfront","tower_name":null,"campaign_name":"Sunrise Bay","property_type":"Apartment","developer_name":"Emaar Properties","project_location":"Dubai Harbour"},"images":[{"340x25