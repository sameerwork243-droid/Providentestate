{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/in-keturah-resort-by-ritz-carlton","result":{"serverData":{"data":{"status":true,"hits":[{"rank":null,"slug":"keturah-resort-by-ritz-carlton-mag-group-al-jaddaf","about":"Keturah Resort by Ritz-Carlton is an ultra-luxury project by Mag Group, developed and designed together with the global brand Ritz-Carlton. The complex consists of an 18-storey tower with 1-3 bedroom apartments and a collection of 8-bedroom mansions.All residences are designed in a modern style using high quality eco-friendly materials and equipped with the highest quality appliances. The panoramic windows offer picturesque views of the Burj Khalifa, Ras Al Khor Nature Reserve and Dubai's famous skyline.Keturah Resort by Ritz-Carlton offers its residents and guests a wide range of luxurious amenities and state-of-the-art services to ensure a comfortable and memorable stay. These include a luxury wellness hotel, a private boat dock for yachts, eight retail spaces focused on sustainable and organic products including a weekend farmers' market, 24-hour secured private valet parking, a gated community with unique views of the wildlife sanctuary and beach access to The Ritz-Carlton Jumeirah Hotel.","price":9287000,"title":"Keturah Resort by Ritz- Carlton","bitrix":{"id":515,"pf_id":null,"source":null,"project_id":"Keturah Resort by Ritz- Carlton","tower_name":null,"campaign_name":"Keturah Resort by Ritz- Carlton","property_type":"Apartment","developer_name":"MAG Group","project_location":"Al Jaddaf"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/336/images/2023/09/12/340x252/Vx2n0SumQKV7biQJU5iLF3GhKGMgKMlix74VX6Cr.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/336/images/2023/09/12/464x312/Vx2n0SumQKV7biQJU5iLF3GhKGMgKMlix74VX6Cr.webp"}],"status":"pending","_geoloc":{"lat":25.2101285,"lng":55.3133726},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.ne