opolis, and investors will be able to receive a high income from the rental of apartments in short or long term rentals","price":14500000,"title":"The S Tower","bitrix":{"id":440,"pf_id":"are.2.12042","source":null,"project_id":"The S Tower","tower_name":null,"campaign_name":"Sobha General","property_type":"Apartment","developer_name":"Sobha Realty","project_location":"Dubai Internet City"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/sLz0VkV9bBuDBSq8zMNSrYb2AKIth4217GpT0a4n.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/464x312/sLz0VkV9bBuDBSq8zMNSrYb2AKIth4217GpT0a4n.webp"}],"status":"ready","_geoloc":{"lat":25.0998016,"lng":55.1682864},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/SiEwZYFjEPEunDMiWpaKsDt64kzdz7GjYk6iVt8E.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/464x312/SiEwZYFjEPEunDMiWpaKsDt64kzdz7GjYk6iVt8E.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/g8Mlce9hdmVykNvsDn82wVhbaqMbhFM9KgKBXnPM.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/464x312/g8Mlce9hdmVykNvsDn82wVhbaqMbhFM9KgKBXnPM.webp"}],"images2":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/sLz0VkV9bBuDBSq8zMNSrYb2AKIth4217GpT0a4n.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/464x312/sLz0VkV9bBuDBSq8zMNSrYb2AKIth4217GpT0a4n.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/SiEwZYFjEPEunDMiWpaKsDt64kzdz7GjYk6iVt8E.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/464x312/SiEwZYFjEPEunDMiWpaKsDt64kzdz7GjYk6iVt8E.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/534/images/2023/11/01/340x252/g8Mlce9hdmVykNvsDn82