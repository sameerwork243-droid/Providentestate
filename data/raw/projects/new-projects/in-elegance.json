{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/in-elegance","result":{"serverData":{"data":{"status":true,"hits":[{"rank":null,"slug":"aura-elegance-aura-infinite-dubai-silicon-oasis","about":"Aura Elegance is a luxury residential development positioned within Dubai Silicon Oasis, a district shaped by modern infrastructure and a strong urban ecosystem. The project is surrounded by key everyday conveniences and benefits from road connectivity via intercity highways, supporting smooth access across Dubai while remaining anchored in a well-established community environment.The unit mix at Aura Elegance by Aura Infinite includes 1 to 3-bedroom apartments with balconies. Lifestyle facilities include an approximately 9,000 sq. ft. leisure area, a temperature-controlled swimming pool with water features, a well-equipped gym, a yoga room, a recreation room, a children’s play area, and a spacious BBQ terrace designed for social gatherings.","price":null,"title":" Aura Elegance","bitrix":{"id":1409,"pf_id":null,"source":null,"project_id":"Aura Elegance","tower_name":null,"campaign_name":"Aura Elegance","property_type":"Apartment","developer_name":"Aura Infinite","project_location":"Dubai Silicon Oasis"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/aura_elegance_feature_51296b5a1c.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/aura_elegance_feature_51296b5a1c.webp"}],"status":null,"_geoloc":{"lat":25.113840388365,"lng":55.139957153889},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/aura_elegance_g_11_5175051d2f.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/aura_elegance_g_11_5175051d2f.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/aura_elegance_g_9_2246f37615.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/464x312/aura_elegance_g_9_2246f37615.webp"},{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/340x252/a