nt.net/x/464x312/aura_elegance_g_8_7326a4ee84.webp"}],"publish":true,"currency":"","features":["urban-living"],"objectID":3087,"amenities":["9000-sq-ft-leisure-area","bbq-area","gym","yoga-room","recreation-room","childrens-play-area","temperature-controlled-pool"],"community":"dubai-silicon-oasis","developer":"aura-infinite","video_url":null,"created_on":1767619713944,"department":"new_developments","modified_on":1767621848154,"search_type":"sales","banner_image":[{"376x":"https://d3h330vgpwpjr8.cloudfront.net/x/376x/aura_elegance_banner_e2b13abeb9.webp","744x":"https://d3h330vgpwpjr8.cloudfront.net/x/744x/aura_elegance_banner_e2b13abeb9.webp","1650x":"https://d3h330vgpwpjr8.cloudfront.net/x/1650x/aura_elegance_banner_e2b13abeb9.webp","376x512":"https://d3h330vgpwpjr8.cloudfront.net/x/376x512/aura_elegance_banner_e2b13abeb9.webp"}],"max_bedrooms":3,"min_bedrooms":1,"search_areas":["aura-elegance","dubai-silicon-oasis","dubai-silicon-oasis","dubai"],"building_type":["apartment"],"display_price":"TBA","future_launch":false,"agent_category":"B","completion_year":"TBA","display_address":"Dubai Silicon Oasis","display_bedrooms":null,"agent_segmentation":"Standard","banner_image_mobile":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/aura_elegance_mobile_c15891e817.jpg","744x":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/744x/aura_elegance_mobile_c15891e817.webp","376x512":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/376x512/aura_elegance_mobile_c15891e817.webp"}]},{"rank":null,"slug":"elegance-marquis-arjan","about":"The Elegance project by Marquis truly impresses with its combination of luxury and accessibility to entertainment. Apartments ranging from one to three bedrooms offer coziness and comfort for various activities. The podium parking and rooftop leisure areas add convenience and uniqueness to this residential complex.On both sides of the building, there are cozy landscaped promenades. The lobby is adorned with glossy black marble, while a grand dome halo the space in light.Each of project's apartments is a cozy oasis for leisurely family time. The kitchen and dining area, well-equipped and decorated in minimalist tones, serve as the heart of every home. The comfortable luxury of the bedrooms is complemented by spacious balconies with breathtaking views of Arjan. Apartments with three bedrooms feature a private pool on the balcony. Additionally, a spacious and well-equipped wardrobe provides ample storage space.The recreational areas deserve special attention. Residents can play billiards, relax in the barbecue area, watch a movie in the open-air amphitheater, or enjoy the coolness of the rooftop pool. There's also a children's pool and playground where your little ones can have fun.The constantly evolving Arjan district has direct access to many of Dubai's attractions. Whether it's entertainment, shopping, or business centers, you'll need no more than half an hour to reach any of these places! For example, you can reach My City Centre Al Barsha or Butterfly Garden in just 5 minutes. In 15 minutes, you'll be at the Mall of the Emirates. The journey to Burj Al Arab and Burj Khalifa will take no more than 20-25 minutes.","price":1057439,"title":"Elegance","bitrix":{"id":746,"pf_id":null,"source":null,"project_id":"Elegance","tower_name":null,"campaign_name":"Elegance","property_type":"Apartment","developer_name":"Marquis","project_location":"Arjan"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/422/images/2023/09/08/340x252/dTmULJboL2Pf42CUa3lHW7Cd5rySUEh0eVbRtZJJ.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/422/images/2023/09/08/464x312/dTmULJboL2Pf42CUa3lHW7Cd5rySUEh0eVbRtZJJ.webp"}],"status":"ready","_geoloc":{"lat":25.0598277,"lng":55.2327399},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/422/images/2023/09/08/340x252/RzOsc51VWYZHZk2SAmCWrgB9a2QSb6IcqxHzKFDA.webp","464x312":"https://d3