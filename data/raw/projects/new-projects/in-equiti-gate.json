{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/in-equiti-gate","result":{"serverData":{"data":{"status":true,"hits":[{"rank":null,"slug":"equiti-gate-refine-development-jebel-ali-freezone-extension","about":"Equiti Gate is where the future begins in the heart of Downtown Jebel Ali, right on Sheikh Zayed Road. The complex is not just a place, but a portal to extraordinary opportunities. Just minutes from the world's largest airport, Al Maktoum International, and the highly anticipated Palm Jebel Ali project, Equiti Gate offers fully furnished studios as well as 1, 2 and 3 bedroom apartments, all with breathtaking panoramic views.Equiti Gate has created a world of its own with amenities catering to every need. Residents are presented with adult and children's pools, a well-equipped gym, outdoor sports court and jogging track. The little ones can have fun in the children's play area or play basketball and table tennis with friends. There is also a lounge area and co-working space for residents.","price":623080,"title":"Equiti Gate","bitrix":{"id":833,"pf_id":"are.2.13314","source":null,"project_id":"Equiti Gate","tower_name":null,"campaign_name":"Equiti Gate","property_type":"Apartment","developer_name":"Refine Development","project_location":"Jebel Ali"},"images":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/611/images/2023/12/14/340x252/B7HTFhuDechprU2ZX8QvapJGpgtejKX2aKfLbNuo.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/611/images/2023/12/14/464x312/B7HTFhuDechprU2ZX8QvapJGpgtejKX2aKfLbNuo.webp"}],"status":"ready","_geoloc":{"lat":24.950204,"lng":55.07258},"country":"dubai","images1":[{"340x252":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/611/images/2023/12/14/340x252/kbkx2MvLvesPDem8pgStlMGlmJhKcG0yp53fVBL9.webp","464x312":"https://d3h330vgpwpjr8.cloudfront.net/x/off-plan/611/images/2023/12/14/464x312/kbkx2MvLvesPDem8pgStlMGlmJhKcG0yp53fVBL9.webp"},{"340x252":"https://d3h330vgpwpjr8.clou