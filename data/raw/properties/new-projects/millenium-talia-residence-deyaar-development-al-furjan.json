ides to its customers around the world.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/195/images/2023/6/6/gbWOFZLmmtMz4ehSvFJvj3ERVY3zEuGIllY2Ux3G.jpg","srcUrl":"https://cdn.geniemap.net/2023/6/6/gbWOFZLmmtMz4ehSvFJvj3ERVY3zEuGIllY2Ux3G.jpg","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/195/images/2023/6/6/PwP3zzokw7NY7lrpqmi6Lynpn036YPiQNgcFuYiv.jpg","srcUrl":"https://cdn.geniemap.net/2023/6/6/PwP3zzokw7NY7lrpqmi6Lynpn036YPiQNgcFuYiv.jpg","__ggfxIndex":1}],"characteristics_module":null,"location_tile":null,"brochure":{"id":2734,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2023/06/20/52Tk7UdLvfIYAZ7lJCgDhZEw5qZSlGH1soT13OPf.pdf","file":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Brochure_2607d7c308.pdf","hash":"Brochure_2607d7c308","name":"Brochure"},"item":[],"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/General_Brochure_90d7160d65.png","hash":"General_Brochure_90d7160d65","name":"General"}},"video_module":{"id":950,"thumbnail":null,"video_url":null},"floor_plans":[{"id":2496,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2497,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"10/90","payment_plans":[{"id":4969,"title":"10%","description":"Down Payment"},{"id":4970,"title":"40%","description":"During Construction"},{"id":4971,"title":"10%","description":"On Handover"},{"id":4972,"title":"36%","description":"3 years post handover"}],"community":"Al Furjan","publish":1,"currency":"AED","amenities":[{"id":7790,"url":null,"text":"Security and CCTV","type":null,"image":null},{"id":7791,"url":nul