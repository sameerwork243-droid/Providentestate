approximately 15 minutes to reach, while Downtown Dubai, Business Bay and Palm Jumeirah are no more than 25 minutes away.</p><p>Dubai Creek Residences is a symbol of prestigious and ultra-modern lifestyle in the heart of Dubai. The complex will be an ideal choice for those looking for comfort in the midst of a bustling metropolis.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/2068/images/2024/06/30/VhLFO3NxvvwKEihh9BQCwZtwi7whlOh67xi7Lznm.jpg","srcUrl":"https://cdn.geniemap.net/2024/06/30/VhLFO3NxvvwKEihh9BQCwZtwi7whlOh67xi7Lznm.jpg","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/2068/images/2024/06/30/YjMDYWSjPggf716mc9AFAMpZg0Gb1HSsqu2jL4ec.jpg","srcUrl":"https://cdn.geniemap.net/2024/06/30/YjMDYWSjPggf716mc9AFAMpZg0Gb1HSsqu2jL4ec.jpg","__ggfxIndex":1},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/2068/images/2024/06/30/dihdiMdUz7HGc6zYPXQyXgaipRNLcPl2DPiSzHOD.jpg","srcUrl":"https://cdn.geniemap.net/2024/06/30/dihdiMdUz7HGc6zYPXQyXgaipRNLcPl2DPiSzHOD.jpg","__ggfxIndex":2}],"characteristics_module":null,"location_tile":null,"brochure":{"id":2775,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2024/05/30/sKe3MUmUP2vdU1KJnCPzpGTZMkhx0XuS58jpPg4W.pdf","file":null,"item":[],"image":null},"video_module":{"id":1602,"thumbnail":null,"video_url":null},"floor_plans":[{"id":1728,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":1729,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":1730,"url":null,"area":null,"size":null,"media":null,"title":"3 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_pr