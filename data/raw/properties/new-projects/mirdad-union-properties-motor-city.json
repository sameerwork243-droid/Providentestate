{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/mirdad-union-properties-motor-city","result":{"serverData":{"data":{"status":true,"message":"Property details fetch successfully","data":{"id":1308,"crm_id":"196","search_type":"sales","department":"new_developments","status":null,"title":"Mirdad","slug":"mirdad-union-properties-motor-city","display_address":"Motor City","building_type":["apartment","loft"],"completion_year":"2028","developer":"Union Properties","price":799000,"display_price":"799k","lattitude":25.0474505,"longitude":55.2074301,"min_bedrooms":1,"max_bedrooms":3,"display_bedrooms":null,"about":"<p>Mirdad at <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/area-guides/dubai-motor-city/\">Motor City</a> is a contemporary residential development by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/new-projects/developed-by-union-properties/\">Union Properties</a>, featuring four architecturally distinct towers of 19, 31, 39, and 13 floors, all connected by a shared podium. The project offers a refined selection of <strong>studios, 1, 2, and 3-bedroom apartments along with 1 to 3-bedroom lofts</strong> designed for comfort and style.</p><p>Mirdad by Union Properties combines sustainability, technology, and design excellence to create a future-ready community. Its strategic location and extensive amenities offer strong potential for high rental yields and long-term capital appreciation, making it equally appealing for both residents and investors seeking growth and lifestyle value.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/mirdad_feature_e9daa75cec.jpg","hash":"mirdad_feature_e9daa75cec","name":"mirdad-feature.jpg"},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/mirdad_banner_21f5ef189a.jpg","hash":"mirdad_banner_21f5ef189a","name":"mirdad-banner.jpg"},"media_images":[{"url":"https