er":"aws-s3","createdAt":"2024-06-21T15:42:30.263Z","updatedAt":"2024-06-21T15:42:30.263Z","folderPath":"/","previewUrl":null,"__ggfxIndex":9,"alternativeText":null,"provider_metadata":null},{"srcUrl":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/karl_61759b739c.jpg","__ggfxIndex":10},{"srcUrl":"https://cdn.geniemap.net/2024/04/17/AiByZGcoTYqPdueO03jyi1aZw73NhUtTTmmPYgTj.jpg","__ggfxIndex":11},{"srcUrl":"https://cdn.geniemap.net/2024/04/17/QVkA0ERXBdpHON0aKsJQwb6oo1nAaln84noWyAXJ.jpg","__ggfxIndex":12},{"srcUrl":"https://cdn.geniemap.net/2024/04/17/Xkj1H4iJHY6b6O64stumsXPuHG66XZSZcwid5lav.jpg","__ggfxIndex":13},{"srcUrl":"https://cdn.geniemap.net/2024/04/17/Wc4q4NWm60ZzOOWqipsDTcKYLMzZuawOPFH99Z1q.jpg","__ggfxIndex":14},{"srcUrl":"https://cdn.geniemap.net/2024/04/17/ck0keLa01JoCN2JWFOFdt6ih0suyQIfqA9n1egO3.jpg","__ggfxIndex":15}],"characteristics_module":{"id":885,"cta":{"id":1492,"icon":null,"menu":null,"cta_label":null,"isExternal":false,"custom_link":null},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/karl_selling_ac8b88d91f.jpg","hash":"karl_selling_ac8b88d91f","name":"Karl Lagerfeld Villas"},"style":null,"title":"Fashion Fused Living at Kar Lagerfeld Villas","heading":"UNIQUE SELLING POINTS","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li><strong>Karl Lagerfeld-Branded Villas: </strong>Unique architectural design infused with the ethos of the Karl Lagerfeld fashion collections, featuring minimalistic, sleek forms and a monochromatic color palette.</li><li><strong>Luxurious Clubhouse Pavilion:</strong> an entertainment space for all ages, 'The Library'—an executive lounge inspired by Lagerfeld’s passion for books, plus a state-of-the-art gym and fitness studio.</li><li><strong>Exquisite Outdoor Amenities:</strong> Features an adult beach-like pool and a children's pool, all set within beautifully landscaped parks and scenic environments.</li><li><strong>Historically Inspired Design: </strong>Reflects the 18th-century style, echoing the façade of Karl Lagerfeld's Paris headquarters, offering a blend of classic and contemporary aesthetics.</li><li><strong>Customizable Villas:</strong> Available in two distinct styles, Soft Modern and Urban Modern, designed for high-net-worth individuals and tailored to personal taste.</li><li><strong>Karl Lagerfeld Villas by Taraf: </strong>A visionary project inspired by what Lagerfeld would envision for his own residence in Dubai, incorporating elements like his vast book collection into the design.&nbsp;</li></ul>","design_title":null},"location_tile":{"id":886,"cta":{"id":1493,"icon":null,"menu":null,"cta_label":null,"isExternal":false,"custom_link":null},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/karl_map_8075333367.jpg","hash":"karl_map_8075333367","name":"Karl Lagerfeld Villas Location"},"style":null,"title":"Live in Harmony with The Golden Landscape of Meydan","heading":"LOCATION","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<p>Located within the Mohamed Bin Rashed Al Maktoum City District, the site is across from Nad Al Sheba and is located right next to a crystal lagoon with uninterrupted views of Downtown Dubai. The development is situated within an iconic zone that creates endless possibilities for exceptional lifestyles.</p><p>Situated in close proximity to Meydan, this is an extraordinary community situated in the heart of Dubai, known for its blend of luxury, sophistication, and world-class amenities. Spanning over a vast area, Meydan offers a unique living experience that combines urban convenience with a tranquil and scenic environment.</p><ul><li>03 Minutes to Nad Al Sheba&nbsp;</li><li>16 Minutes to Meydan Racecourse</li><li>19 Minutes to Downtown&nbsp;</li><li>27 Minutes to DXB Airport</li></ul>","design_title":null},"brochure":{"id":2973,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2024/04/17/jYd4fsMBfpyYjHIPKoaAFk9KCBVf6vieOBWEyojn.pdf","file":null,"item":[],"image":null},"video_module":null,"floor_plans":[{"id":1295,"url":null,"area":null,"size":null,"media":null,"title":"5 Bedroom Villas","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":1296,"url":null,"area":null,"size":null,"media":null,"title":"6 Bedroom Villas","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":1297,"url":null,"area":null,"size":null,"media":null,"title":"7 Bedroom Villas","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"60/40","payment_plans":[{"id":6940,"title":"10%","description":"Down Payment"},{"id":6941,"title":"50%","description":"During Construction"},{"id":6942,"title":"40%","description":"On Handover"}],"community":"Meydan","publish":1,"currency":"","amenities":[{"id":12371,"url":null,"text":"Children’s Pool","type":null,"image":null},{"id":12372,"url":null,"text":"Shared Pool","type":null,"image":null},{"id":12373,"url":null,"text":"Shared Gym & Fitness","type":null,"image":null},{"id":12374,"url":null,"text":"Leisure Areas","type":null,"image":null},{"id":12375,"url":null,"text":"Club House","type":null,"image":null},{"id":12376,"url":null,"text":"Recreational Areas","type":null,"image":null},{"id":12377,"url":null,"text":"Landscaped Garden","type":null,"image":null},{"id":12378,"url":null,"text":"Library","type":null,"image":null}],"bitrix":{"id":505,"pf_id":"are.2.13728","source":null,"project_id":"Karl Lagerfeld Villas","tower_name":null,"campaign_name":"Karl Lagerfeld Villas","property_type":"Villas","developer_name":"Taraf","project_location":"Nad Al Sheba"},"banner_image_mobile":null,"seo":{"id":437,"metaTitle":"Karl Lagerfeld Villas by Taraf in Meydan, Dubai","canonicalURL":null,"metaDescription":"Experience haute couture living in Meydan with Karl Lagerfeld Villas—5-7 bedroom residences featuring Parisian-inspired design and exclusive amenities.\n"},"more_info":[{"id":1711,"answer":"<p>The Karl Lagerfeld Villas by Taraf is a premium villa development located in the heart of Mohammed Bin Rashid City (MBR City), Dubai. This unique collaboration between Taraf Properties and the iconic fashion designer Karl Lagerfeld merges high fashion with architectural elegance, offering a luxurious lifestyle that epitomizes sophistication.<br>&nbsp;</p>","question":"What is the Karl Lagerfeld Villas by Taraf?"},{"id":1712,"answer":"<p>The development offers 51 exclusive villas with options ranging from 5 to 7 bedrooms. The spacious properties vary in size from 722 to 1790 square meters, designed for those who value luxury and high-quality living environments.<br>&nbsp;</p>","question":"What types of properties are available at Karl Lagerfeld Villas Dubai?"},{"id":1713,"answer":"<p>Prices for the villas start at approximately $4,186,400 (15,375,000 AED), catering to high-net-worth individuals looking for luxury real estate in a prestigious area of Dubai.<br>&nbsp;</p>","question":"What is the starting price for a villa at Karl Lagerfeld Villas Dubai?"},{"id":1714,"answer":"<p>Investing in the Karl Lagerfeld Villas by Taraf offers significant advantages, including strong rental demand and good potential for return on investment (ROI). The strategic location provides easy access to major Dubai attractions like Downtown Dubai, Dubai Opera, and Dubai International Airport, making it highly attractive to both residents and investors.<br>&nbsp;</p>","question":"What are the benefits of investing in Karl Lagerfeld Villas by Taraf?"},{"id":1715,"answer":"<p>The villas boast a range of luxurious amenities, including spacious interiors, smart home appliances, and high-grade materials and fittings. The attention to detail and use of fine materials reflect Karl Lagerfeld’s signature style, ensuring a premium living experience.<br>&nbsp;</p>","question":"