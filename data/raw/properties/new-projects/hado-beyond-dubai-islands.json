dentestate.s3.eu-west-2.amazonaws.com/i/Gallery_2_1ebd3e4bc2.jpg","hash":"Gallery_2_1ebd3e4bc2","name":"Gallery-2.jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Gallery_4_f199e50a48.jpg","hash":"Gallery_4_f199e50a48","name":"Gallery-4.jpg"}],"images":null,"characteristics_module":{"id":1941,"cta":{"id":2751,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Selling_Point_60df3613dc.jpg","hash":"Selling_Point_60df3613dc","name":"Selling-Point.jpg"},"style":null,"title":"Hado by Beyond: A Waterfront Living Experience Inspired by Ikigai","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Hado’s residences are crafted to embody the Japanese philosophy of Ikigai, offering homes that bring purpose, harmony, and daily joy into the living experience.</li><li>Each apartment features expansive glazing and thoughtful layouts that frame serene views of the sea, cove, and skyline, creating a calming connection to nature.</li><li>Located in Siora on Dubai Islands, the community provides direct access to pristine beaches, lush landscapes, and wellness-focused surroundings designed to support balanced living.</li><li>The architecture of the three sculpted towers reflects movement and stillness in perfect balance, mirroring the essence of Ikigai through natural light, proportion, and intentional design.</li><li>Residents enjoy world-class amenities in Hado amenities including a tranquil arrival lobby, wellness spa, fitness studio, Chef’s Kitchen, cigar lounge, and children’s areas - curated to enrich everyday life.</li><li>With only a 10% booking payment required, Hado offers an attractive and accessible entry into one of Dubai’s most elegant new waterfront communities.</li></ul>","design_title":null},"location_tile":{"id":1942,"cta":{"id":2752,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Map_Location_c9ea92f1a7.jpg","hash":"Map_Location_c9ea92f1a7","name":"Map-Location.jpg"},"style":null,"title":"Dubai Islands – A Premier Coastal Destination ","heading":"Location","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<p>Hado by Beyond is positioned at the heart of Siora on Dubai Islands, within a masterplan shaped by purposeful living. Dubai Islands emerges as one of the city’s most prestigious mixed-use waterfront destinations, bringing together upscale residences, world-class hospitality, vibrant marinas, and more than 20 kilometres of pristine shoreline, including a certified Blue Flag beach. With seamless access by road and sea, it is envisioned to host over 80 hotels, lush parks, premium golf courses, and an interconnected network of promenades and transport routes.</p><ul><li>Gold Souq Metro Station – 10 minutes</li><li>Dubai International Airport (DXB) – 19 minutes</li><li>Dubai Frame – 18 minutes</li><li>DIFC (Dubai International Financial Centre) – 20 minutes</li><li>Downtown Dubai – 20 minutes</li></ul>","design_title":null},"brochure":{"id":4680,"url":"","file":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/brochure_9b27ed03e4.pdf","hash":"brochure_9b27ed03e4","name":"brochure"},"item":[],"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/General_Brochure_90d7160d65.png","hash":"General_Brochure_90d7160d65","name":"General"}},"video_module":{"id":3335,"thumbnail":null,"video_url":null},"floor_plans":[{"id":4437,"url":null,"area":null,"size":"767 sq. ft. to 1,426 sq. ft.","media":null,"title":"1 Bedroom Residences","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":4438,"url":null,"area":null,"size":"1,06