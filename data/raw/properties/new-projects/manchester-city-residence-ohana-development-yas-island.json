_g_9_24c98dd714","name":"ohana-g-9.jpg"}],"images":[],"characteristics_module":{"id":2023,"cta":{"id":2853,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/ohana_SP_c80fa77901.jpg","hash":"ohana_SP_c80fa77901","name":"ohana-SP.jpg"},"style":null,"title":"Manchester City Residences Yas Island – A Globally Branded Waterfront Lifestyle on Yas Island","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Prime Yas Island Canal Location – Situated within a canal-integrated master plan inside Abu Dhabi’s leading leisure and sports destination.</li><li>Global Brand – A lifestyle community inspired by one of the world’s most iconic football brands.</li><li>Diverse Unit Options – Apartments, penthouses, townhouses, villas, and mansions designed for varied lifestyle and investment needs.</li><li>Low-Density – Exceptional spacing between buildings enhances privacy, airflow, and natural daylight throughout the community.</li><li>Park-Centric Living – Landscaped parks and green corridors create a balanced residential setting focused on outdoor living.</li><li>Waterfront Lifestyle – Direct canal views and waterfront jogging and cycling paths define everyday life.</li><li>Developed by Ohana – A vision-led developer focused on quality, design integrity, and long-term value creation.</li><li>Strong Capital Appreciation – Limited canal-front supply, global brand premium, and Yas Island expansion support long-term growth.</li></ul>","design_title":null},"location_tile":{"id":2024,"cta":{"id":2854,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/ohana_map_3c110f72d0.jpg","hash":"ohana_map_3c110f72d0","name":"ohana-map.jpg"},"style":nul