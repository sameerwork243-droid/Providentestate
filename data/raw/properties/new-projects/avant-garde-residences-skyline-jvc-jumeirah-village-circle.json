-20 minutes' drive, offering residents a variety of leisure activities.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/774/images/2024/01/23/QRyxnlUHbLV3t67VVpOIgOqbaYLc8rp0FngtKA4c.jpg","srcUrl":"https://cdn.geniemap.net/2024/01/23/QRyxnlUHbLV3t67VVpOIgOqbaYLc8rp0FngtKA4c.jpg","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/774/images/2024/01/23/Ucj5Yd8hEbovjV03kGzGdKaMYdzria3LVYTWgaxq.jpg","srcUrl":"https://cdn.geniemap.net/2024/01/23/Ucj5Yd8hEbovjV03kGzGdKaMYdzria3LVYTWgaxq.jpg","__ggfxIndex":1},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/774/images/2024/01/23/UmGhsBfFG522HdsB79cizqlabO7A6AMvmPSqAc4q.jpg","srcUrl":"https://cdn.geniemap.net/2024/01/23/UmGhsBfFG522HdsB79cizqlabO7A6AMvmPSqAc4q.jpg","__ggfxIndex":2}],"characteristics_module":null,"location_tile":null,"brochure":{"id":2952,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2024/01/23/oU2qyorQQZ8WkrzubY4GTVCLhiGiTn16OnmxugEj.pdf","file":null,"item":[],"image":null},"video_module":{"id":1247,"thumbnail":null,"video_url":null},"floor_plans":[{"id":2229,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2230,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"50/50 ","payment_plans":[{"id":6148,"title":"10%","description":"Down payment"},{"id":6149,"title":"10%","description":"2 months from booking"},{"id":6150,"title":"30%","description":"Within 30 months"},{"id":6151,"title":"50%","description":"On completion"}],"community":"Jumeirah Village Circle (JVC)","publish":1,"currency":"","amenities":[{"id":10319,"url":null,"text":"Covered Parking","type":null,"image":