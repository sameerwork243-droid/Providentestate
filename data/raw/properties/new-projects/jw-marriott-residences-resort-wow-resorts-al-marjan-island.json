-plan/586/images/2024/02/17/2FrWfdzuFngBNlFk8wVxTcxZA9FgdWBn44B2j7At.png","srcUrl":"https://cdn.geniemap.net/2024/02/17/2FrWfdzuFngBNlFk8wVxTcxZA9FgdWBn44B2j7At.png","__ggfxIndex":2}],"characteristics_module":{"id":1590,"cta":{"id":2375,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/JW_Marriott_Residences_Al_Marjan_Island_c0dc3b5010.jpg","hash":"JW_Marriott_Residences_Al_Marjan_Island_c0dc3b5010","name":"JW Marriott Residences Al Marjan Island"},"style":null,"title":"JW Marriott Residences & Resort in Al Marjan Island – A Benchmark in Luxury Living","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Prime Island Location – Situated on Al Marjan Island, offering residents unparalleled beachfront living with stunning sea views.</li><li>Marriott Bonvoy Platinum Elite Status – Enjoy two years of exclusive Marriott Bonvoy Platinum Elite membership, enhancing your lifestyle with premium benefits.</li><li>Architectural Excellence – Designed by renowned architect Tony Ashai, blending modern aesthetics with functional luxury.</li><li>Comprehensive Services – Benefit from 24/7 room service and housekeeping, ensuring comfort and convenience at all times.</li><li>Proximity to Wynn Resort – Located near the upcoming Wynn Resort, the UAE's first integrated gaming destination, adding entertainment and investment value.</li><li>Fully Furnished Residences – Each unit comes fully furnished and equipped, ready for immediate occupancy.</li><li>Exclusive Amenities – Access to private beach, beach bar, infinity pool, kids club, and more, catering to all lifestyle needs.</li><li>Flexible Payment Options – Attractive 70/30 payment plan, making luxury living more accessible.</li></ul>","design_title":null},"location_tile":{"id":1591,"cta":{"id":2376,"icon":null,"menu"