xternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Selling_Point_82fa7d6613.jpg","hash":"Selling_Point_82fa7d6613","name":"Selling-Point.jpg"},"style":null,"title":"The Meriva Collection Dubai Islands by Ellington Properties Redefines Coastal Living Excellence","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Prime Beachfront Address – Located on Island B with dedicated private beach access and uninterrupted sea views</li><li>Low-Density Island Setting – Limited developments on Island B ensure exclusivity and long-term value growth</li><li>Design-Led Architecture – Six fluidly designed buildings shaped by curved terraces and coastal-inspired materials</li><li>Pedestrianised Waterfront Community – Meandering waterways and landscaped paths connect residences directly to the shoreline</li><li>Resort-Style Amenities – Infinity pools, indoor lap pools, fitness pavilion, private cinema, and curated social spaces</li><li>Signature Penthouses Collection – 11 exclusive penthouses with expansive terraces, private pools, and rooftop gym access</li><li>Hospitality Integration – Ellington Hotel on site, managed by a reputable hospitality operator.</li><li>Structured Investor-Friendly Plan – Phased payment structure designed to support capital growth potential in a waterfront district.</li></ul>","design_title":null},"location_tile":{"id":2109,"cta":{"id":2947,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Map_Location_48bc9bcfb6.jpg","hash":"Map_Location_48bc9bcfb6","name":"Map-Location.jpg"},"style":null,"title":"Waterfront Serenity in Dubai Islands","heading":"Location","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"descr