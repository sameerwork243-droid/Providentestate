ed by Michelin-starred restaurants, art galleries, luxury retail, and world-renowned financial institutions, DIFC is a symbol of elegance and global connectivity.</p><ul><li>Dubai Metro – 5 minutes</li><li>Burj Khalifa – 5 minutes</li><li>Museum of the Future – 12 minutes</li><li>Jumeirah Beach – 15 minutes</li><li>Dubai International Airport (DXB) – 20 minutes</li></ul>","design_title":null},"brochure":{"id":3832,"url":null,"file":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/brochure_a51b930601.pdf","hash":"brochure_a51b930601","name":"brochure"},"item":[],"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/General_Brochure_90d7160d65.png","hash":"General_Brochure_90d7160d65","name":"General"}},"video_module":{"id":2546,"thumbnail":null,"video_url":null},"floor_plans":[{"id":3485,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/DIFC_Heights_Tower_by_DIFC_Development_5eaf98af79.jpg","hash":"DIFC_Heights_Tower_by_DIFC_Development_5eaf98af79","name":"DIFC Heights Tower by DIFC Development"},"title":"1 Bedroom Residences","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":3486,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/DIFC_Heights_Tower_by_DIFC_Development_f35eb4e32e.jpg","hash":"DIFC_Heights_Tower_by_DIFC_Development_f35eb4e32e","name":"DIFC Heights Tower by DIFC Development"},"title":"2 Bedroom Residences","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":3487,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/DIFC_Heights_Tower_by_DIFC_Development_1404acafe8.jpg","hash":"DIFC_Heights_Tower_by_DIFC_Development_1404acafe8","name":"DIFC Heights Tower by DIFC Development"},"title":"3 Bedroom Residences","kitchen":null,"parking":null,"flooring":null,"ceili