{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/cheval-residences-avenew-development-dubai-islands","result":{"serverData":{"data":{"status":true,"message":"Property details fetch successfully","data":{"id":1454,"crm_id":"8063","search_type":"sales","department":"new_developments","status":null,"title":"Cheval Residences","slug":"cheval-residences-avenew-development-dubai-islands","display_address":"Dubai Islands","building_type":["apartment"],"completion_year":"2029","developer":"Avenew Development","price":null,"display_price":"TBA","lattitude":25.308774622428,"longitude":55.315263919063,"min_bedrooms":1,"max_bedrooms":3,"display_bedrooms":null,"about":"<p>Cheval Residences <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/area-guides/dubai-islands/\">Dubai Islands</a> is a premier collection of 99 branded serviced hotel residences developed by<a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/new-projects/developed-by-avenew-properties/\"> Avenew Development</a> and Wadeen Developers on the prestigious Dubai Islands. Rising G+7 floors, the project offers <strong>1, 2, and 3 bedroom apartments</strong> ranging from 763 to 4,322 sq ft, each delivering elevated panoramic views.</p><p>Managed under the globally recognised Cheval Collection hospitality brand, residents enjoy five-star hotel services within a refined private sanctuary. World-class amenities including an infinity pool, rooftop terrace, pool bar, and beach access make Cheval Residences at Dubai Islands an unmatched lifestyle and investment opportunity.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Feature_3019aae7cd.jpg","hash":"Feature_3019aae7cd","name":"Feature.jpg"},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Banner_61899fe675.jpg","hash":"Banner_61899fe675","name":"Banner.jpg"},"media_images":[{"url":"https://ggfx-providentes