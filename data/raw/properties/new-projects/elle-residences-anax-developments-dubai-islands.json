{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/elle-residences-anax-developments-dubai-islands","result":{"serverData":{"data":{"status":true,"message":"Property details fetch successfully","data":{"id":1391,"crm_id":"6217","search_type":"sales","department":"new_developments","status":null,"title":"ELLE Residences","slug":"elle-residences-anax-developments-dubai-islands","display_address":"Dubai Islands","building_type":["apartment","townhouse"],"completion_year":"2027","developer":"ANAX Developments","price":2150000,"display_price":"2.15M","lattitude":25.292551707986,"longitude":55.291339373282,"min_bedrooms":1,"max_bedrooms":3,"display_bedrooms":null,"about":"<p>ELLE Residences at <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/area-guides/dubai-islands/\">Dubai Islands</a> is Dubai’s first ELLE-branded residential development, created by ANAX Developments in collaboration with the globally influential fashion and lifestyle brand ELLE. Set on the main island of Dubai Islands, the project introduces a new chapter of waterfront living where editorial sophistication meets immersive seafront design. The development features a limited collection of <strong>1, 2 &amp; 3-bedroom apartments</strong> <strong>and exclusive townhouses</strong>, each designed to frame sweeping sea, marina, and Downtown skyline views. Sculptural architecture, floor-to-ceiling windows, and fully equipped interiors define every home, ensuring light-filled spaces and seamless indoor-outdoor living. With only 98 residences in a G+2 podium plus 10 floors structure, ELLE Residences delivers privacy, prestige, and a refined coastal lifestyle in one of Dubai’s most promising waterfront destinations.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/ELLE_Residences_feature_ae4c842136.jpg","hash":"ELLE_Residences_feature_ae4c842136","name":"ELLE-Residences-feature.jpg"},"banner_image":{"url":"https