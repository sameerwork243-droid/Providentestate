na is just a 15-minute drive away, and Al Maktoum International Airport is a 20-minute drive away.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/579/images/2024/04/15/a9ROnxtoDp52DCqYt5UEbjd3SxLn71yg8AHPAFTu.png","srcUrl":"https://cdn.geniemap.net/2024/04/15/a9ROnxtoDp52DCqYt5UEbjd3SxLn71yg8AHPAFTu.png","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/579/images/2024/04/15/CQ8XYFEvUZlIsdOF9eed9ilCK6gI2EBncgplYTyl.png","srcUrl":"https://cdn.geniemap.net/2024/04/15/CQ8XYFEvUZlIsdOF9eed9ilCK6gI2EBncgplYTyl.png","__ggfxIndex":1},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/579/images/2024/04/15/2DepICiTFDRudEPvXm0PDbjOKwn89BluTtZ7YeXl.png","srcUrl":"https://cdn.geniemap.net/2024/04/15/2DepICiTFDRudEPvXm0PDbjOKwn89BluTtZ7YeXl.png","__ggfxIndex":2},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/579/images/2024/04/15/MbU3LYwRACzIR8z0PaGi7DTK2UB0C8NvHAzMNDQs.jpg","srcUrl":"https://cdn.geniemap.net/2024/04/15/MbU3LYwRACzIR8z0PaGi7DTK2UB0C8NvHAzMNDQs.jpg","__ggfxIndex":3}],"characteristics_module":null,"location_tile":null,"brochure":{"id":1940,"url":"","file":null,"item":[],"image":null},"video_module":{"id":1192,"thumbnail":null,"video_url":null},"floor_plans":[{"id":2124,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2125,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2126,"url":null,"area":null,"size":null,"media":null,"title":"4 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"35/65","payment_plans":[{"id":5982,"title":"10%","description":