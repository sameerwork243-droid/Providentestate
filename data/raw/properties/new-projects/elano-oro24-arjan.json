le the Burj Khalifa and Dubai Marina can be reached within a 20-minute drive.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/1236/images/2024/02/29/dNuQWOUSpYZ5kZ9cfkkH0zEN5AiNGNaEn1Tc1IqX.jpg","srcUrl":"https://cdn.geniemap.net/2024/02/29/dNuQWOUSpYZ5kZ9cfkkH0zEN5AiNGNaEn1Tc1IqX.jpg","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/1236/images/2024/02/29/xjlbQEOImREU7xwmXoZRUyiE570qRZtc1tMJC6Wz.jpg","srcUrl":"https://cdn.geniemap.net/2024/02/29/xjlbQEOImREU7xwmXoZRUyiE570qRZtc1tMJC6Wz.jpg","__ggfxIndex":1},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/1236/images/2024/02/29/sjZJSZrSFswdFURtpeOWqRUNqnrgOEmsJm0Y1z59.jpg","srcUrl":"https://cdn.geniemap.net/2024/02/29/sjZJSZrSFswdFURtpeOWqRUNqnrgOEmsJm0Y1z59.jpg","__ggfxIndex":2}],"characteristics_module":null,"location_tile":null,"brochure":{"id":2892,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2024/02/29/LvaIjhkM8pl73IOX9sTIwKj8Dc3ghvWUwhIrlS8B.pdf","file":null,"item":[],"image":null},"video_module":{"id":1157,"thumbnail":null,"video_url":null},"floor_plans":[{"id":2000,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2001,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2002,"url":null,"area":null,"size":null,"media":null,"title":"Studio","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"","payment_plans":[],"community":"Arjan","publish":1,"currency":"","amenities":[{"id":9599,"url":null,"text":"Shared Pool","type":null,"image":null},{"id":9600,"url":null,"text":"Lobby","type":null,"image":null},{"id":9601,"url":null,"