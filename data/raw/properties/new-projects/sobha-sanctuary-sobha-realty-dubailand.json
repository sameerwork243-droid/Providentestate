{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/sobha-sanctuary-sobha-realty-dubailand","result":{"serverData":{"data":{"status":true,"message":"Property details fetch successfully","data":{"id":1386,"crm_id":"7282","search_type":"sales","department":"new_developments","status":null,"title":"Sobha Sanctuary","slug":"sobha-sanctuary-sobha-realty-dubailand","display_address":"Dubailand","building_type":["villa"],"completion_year":"TBA","developer":"Sobha Realty","price":3900000,"display_price":"3.9M","lattitude":24.991802232371,"longitude":55.421556744999,"min_bedrooms":4,"max_bedrooms":6,"display_bedrooms":null,"about":"<p>Sobha Sanctuary in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/area-guides/dubailand/\">Dubailand </a>is a visionary master-planned destination spanning 35 million sq. ft., developed by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/new-projects/developed-by-sobha-realty/\">Sobha Realty</a>. Designed as a low-density, high-end residential enclave, its first phase includes an exclusive selection of 4 to 6-bedroom villas set within landscaped parks, crystal lagoons, and waterfront walkways, shaping a refined lifestyle environment.</p><p>Conceived as a fully integrated community, Sobha Sanctuary by Sobha Realty blends contemporary architecture with nature-led planning and premium amenities. Fitness facilities, sports courts, and serene green zones enhance daily living, while the scale, design quality, and self-sufficient infrastructure position the development for strong long-term capital appreciation.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Feature_c8fbc68ccb.jpg","hash":"Feature_c8fbc68ccb","name":"Feature.jpg"},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Banner_d261924943.jpg","hash":"Banner_d261924943","name":"Banner.jpg"},"media_images":[{"url":"https://ggf