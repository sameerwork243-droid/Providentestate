i/thumbnail_4_36f20d5e08.jpg","hash":"thumbnail_4_36f20d5e08","mime":"image/jpeg","name":"thumbnail_4.jpg","path":null,"size":8.84,"width":245,"height":140}},"provider":"aws-s3","createdAt":"2024-11-28T13:47:21.373Z","updatedAt":"2024-11-28T13:57:09.397Z","folderPath":"/","previewUrl":null,"__ggfxIndex":10,"alternativeText":"LIV Maritime","provider_metadata":null}],"characteristics_module":{"id":1204,"cta":{"id":1969,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/sp_43ed638f28.jpg","hash":"sp_43ed638f28","name":"LIV Maritime"},"style":null,"title":"LIV the Coastal Luxury With Seamless Convenience!","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Flexible Payment Plan: Pay 45% during construction and 55% on handover, ensuring a stress-free investment journey.</li><li>Breathtaking Waterfront Views: Enjoy panoramic vistas of the Arabian Sea, Jumeirah Coastline, Rashid Yachts &amp; Marina, and the Downtown Dubai skyline.</li><li>Prime Location: Situated in Dubai Maritime City, offering effortless access to key destinations such as DIFC, Downtown Dubai, and La Mer.</li><li>Luxury Amenities: Over 29,000 sq. ft. of world-class facilities, including an oversized pool, zen garden, spa, and fitness center.</li><li>Smart Home Technology: Residences equipped with advanced features for ultimate convenience and modern living.</li><li>Architectural Elegance: A striking 47-story glass tower designed to redefine luxury waterfront living.</li><li>Premium Residences: Choose from 1, 2, and 3-bedroom apartments, duplexes, and townhouses with bespoke interiors and European kitchens.</li></ul>","design_title":null},"location_tile":{"id":1205,"cta":{"id":1970,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/map_5413f01b62.jpg","hash":"map_5413f01b62","name":"LIV Maritime Location"},"style":null,"title":"Embrace the Future: Invest in Dubai Maritime City","heading":"Location","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<p>Dubai Maritime City is rapidly emerging as a premier destination for investors, offering a blend of strategic location, cutting-edge infrastructure, and world-class amenities. As a vital part of Dubai’s Urban Master Plan, it is transforming into a highly connected “20-minute city,” making it an ideal choice for property investment.</p><p>Among the significant infrastructure upgrades is the Al Shindagha Corridor Project. This project features the construction of three bridges, reducing travel times between Dubai Maritime City, DIFC, Trade Centre, and other major hubs. Additionally, the Dubai Metro Extension Project will further expand the world’s longest driverless rail network, ensuring seamless transportation options for residents and visitors alike.</p><ul><li>Rashid Yachts &amp; Marina - 5 minutes</li><li>Dubai Cruise Terminal - 5 minutes</li><li>Pearl Jumeirah - 7 minutes</li><li>La Mer - 10 minutes</li><li>Dubai International Financial Centre (DIFC) - 15 minutes</li><li>Downtown Dubai - 15 minutes</li><li>Dubai International Airport - 20 minutes</li></ul>","design_title":null},"brochure":{"id":3380,"url":null,"file":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/LIV_Maritime_Brochure_ee037689fb.pdf","hash":"LIV_Maritime_Brochure_ee037689fb","name":"LIV Maritime Brochure"},"item":[],"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/General_Brochure_90d7160d65.png","hash":"General_Brochure_90d7160d65","name":"General"}},"video_module":null,"floor_plans":[{"id":2906,"url":null,"area":null,"size":null,"media":null,"title":"1 Bedroom Apartments","kitchen":null,"p