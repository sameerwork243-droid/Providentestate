yle.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_23a56b23ec.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_23a56b23ec","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_3c0dd81461.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_3c0dd81461","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},"media_images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_42553c42ea.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_42553c42ea","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_3d874d5b9a.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_3d874d5b9a","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_975a2529d0.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_975a2529d0","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_fc5cc14d3e.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_fc5cc14d3e","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_b3c05420f5.jpg","hash":"Sobha_Skyvue_Stellar_Apartments_at_Sobha_Hartland_2_b3c05420f5","name":"Sobha Skyvue Stellar Apartments at Sobha Hartland 2"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sobh