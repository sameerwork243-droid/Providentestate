nd DIFC and Downtown Dubai are 15 minutes away, Sheikh Mohammed Bin Zayed Rd (E311) is 3 minutes away and Al Khail Rd is 8 minutes away. The Gardens Metro Station is 7 minutes away, International Airports are 20 minutes away.</p>","tile_image":null,"banner_image":null,"media_images":null,"images":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/484/images/2023/10/09/AYbo1WPF7YFxY0ck7YFYpamQCebUPo7XrDOJeJQT.jpg","srcUrl":"https://cdn.geniemap.net/2023/10/09/AYbo1WPF7YFxY0ck7YFYpamQCebUPo7XrDOJeJQT.jpg","__ggfxIndex":0},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/484/images/2023/10/09/BKn1cptGNu1RJhGKe52a9bYhQ9NTDq7ieBWvm8xh.jpg","srcUrl":"https://cdn.geniemap.net/2023/10/09/BKn1cptGNu1RJhGKe52a9bYhQ9NTDq7ieBWvm8xh.jpg","__ggfxIndex":1},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/off-plan/484/images/2023/10/09/OWBgkfg1chc69S8cTlQaKPsU1NpiY3Z1CXVPe19P.jpg","srcUrl":"https://cdn.geniemap.net/2023/10/09/OWBgkfg1chc69S8cTlQaKPsU1NpiY3Z1CXVPe19P.jpg","__ggfxIndex":2}],"characteristics_module":null,"location_tile":null,"brochure":{"id":2947,"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/2023/10/09/cvmPgKuu2Ex7ON3L3zkdJTpMRFWWCZwNqetfcRSr.pdf","file":null,"item":[],"image":null},"video_module":{"id":1467,"thumbnail":null,"video_url":null},"floor_plans":[{"id":1348,"url":null,"area":null,"size":"847.87 ft²","media":null,"title":"1 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":1349,"url":null,"area":null,"size":null,"media":null,"title":"2 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":2203,"url":null,"area":null,"size":null,"media":null,"title":"3 Bedroom Apartment","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"20/80","payment_plans":[{"id":7049,"title":"20%","description":"On bo