{"componentChunkName":"component---src-pages-new-projects-js","path":"new-projects/baystar-by-vida-emaar-properties-mina-rashid","result":{"serverData":{"data":{"status":true,"message":"Property details fetch successfully","data":{"id":1226,"crm_id":"5784","search_type":"sales","department":"new_developments","status":"pending","title":"Baystar by Vida","slug":"baystar-by-vida-emaar-properties-mina-rashid","display_address":"Rashid Yachts & Marina (Mina Rashid)","building_type":["apartment"],"completion_year":"2029","developer":"Emaar Properties","price":2100000,"display_price":"2.1M","lattitude":25.257023678908,"longitude":55.27974946342,"min_bedrooms":1,"max_bedrooms":4,"display_bedrooms":null,"about":"<p>Baystar by VIDA is the first VIDA-branded residential project in <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/new-projects/developed-by-emaar-properties/\">Rashid Yachts &amp; Marina</a> by <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://providentestate.com/new-projects/developed-by-emaar-properties/\">Emaar</a>, featuring two elegant towers with <strong>1 to 4-bedroom apartments</strong> that combine waterfront luxury with VIDA’s signature hospitality, modern interiors, and stunning marina views.</p><p>Residents enjoy hotel-style services including concierge, housekeeping, and valet, alongside resort-style amenities like an infinity pool, wellness zones, gym, and direct yacht access. With its prime location near Downtown Dubai and strong investment potential, Baystar by VIDA sets a new benchmark for luxury marina living.</p>","tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Baystar_by_Vida_at_Rashid_Yachts_Emaar_Waterfront_Living_a3cc093e8c.jpg","hash":"Baystar_by_Vida_at_Rashid_Yachts_Emaar_Waterfront_Living_a3cc093e8c","name":"Baystar by Vida at Rashid Yachts | Emaar Waterfront Living "},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Baystar_b