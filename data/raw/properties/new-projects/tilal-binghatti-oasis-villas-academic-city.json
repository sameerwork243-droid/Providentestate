y_4_af5d31f112.jpg","hash":"Gallery_4_af5d31f112","name":"Gallery-4.jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Gallery_2_d69b87fc41.jpg","hash":"Gallery_2_d69b87fc41","name":"Gallery-2.jpg"}],"images":[],"characteristics_module":{"id":2166,"cta":{"id":3003,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Selling_Point_deb0b82ef9.jpg","hash":"Selling_Point_deb0b82ef9","name":"Selling-Point.jpg"},"style":null,"title":"A New Standard for Central Villa Living","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li><strong>Central Community Position</strong> - Located at the heart of the Tilal Binghatti masterplan, with direct connections to the beachfront, central green parks, and the community clubhouse.</li><li><strong>Spacious 4-Bedroom Layouts</strong> - Each villa offers four bedrooms with attached bathrooms, a driver's and maid's room, an in-unit elevator, dedicated storage, and a private rooftop.</li><li><strong>Vibrant Social Setting</strong> - Open green spaces, leisure destinations, and family-friendly experiences positioned at the meeting point of every surrounding cluster.</li><li><strong>Move-In Ready Landscaping</strong> - Villas are handed over with grass-finished outdoor spaces, removing the post-handover landscaping burden common with off-plan villa purchases.</li><li><strong>Smart Home Integration</strong> - Every villa includes integrated smart home technology, with the wider community supported by EV charging, smart irrigation, and solar lighting.</li><li><strong>Freehold Ownership</strong> - Open to both residents and international investors, with full freehold title within the community.</li><li><strong>Starting Price</strong> - Villas at Tilal Binghatti Oasis start from AED 4.2M, offering a competitive entry point into a premium gated villa community in Academic City.</li></ul>","design_title":null},"location_tile":{"id":2167,"cta":null,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Map_Location_fc6da5d99b.jpg","hash":"Map_Location_fc6da5d99b","name":"Map-Location.jpg"},"style":null,"title":"Connected to Dubai’s Key Destinations","heading":"Location","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<p>Located in Dubai International Academic City, Tilal Binghatti Oasis Villas combines peaceful community living with seamless city connectivity. The masterplan offers convenient access to Downtown Dubai, Dubai International Airport, major highways, educational institutions, and the upcoming Blue Line Metro, placing residents within reach of Dubai’s key destinations.</p><p>10 Minutes - Meydan Racecourse<br>15 Minutes - Dubai Creek Harbour<br>17 Minutes - Burj Khalifa &amp; Dubai Mall<br>18 Minutes - DXB International Airport<br>20 Minutes - Museum of the Future<br>35 Minutes - Palm Jumeirah</p>","design_title":null},"brochure":{"id":5086,"url":"","file":null,"item":[],"image":null},"video_module":{"id":3705,"thumbnail":null,"video_url":null},"floor_plans":[{"id":4859,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Floorplan_The_Residence_Collection_0dd123a7ae.jpg","hash":"Floorplan_The_Residence_Collection_0dd123a7ae","name":"Floorplan-The-Residence-Collection.jpg"},"title":"4 cBedroom Villas","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null}],"payment_plan_text":"TBA","payment_plans":[],"community":"Academic City","publish":1,"currency":"","amenities":[{"id":40343,"url":null,"text":"Swimming Pool","type":null,"image":null},{"id":40344,"url":null,"text":"Pearl Beach","type":null,"image":null},{"id":40345,"url":null,"text":"Alwaha Swimmable Lakes","type":null,"image":null},{"i