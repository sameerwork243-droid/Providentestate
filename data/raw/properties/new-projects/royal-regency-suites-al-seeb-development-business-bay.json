ency_Suites_g_2_85adebcee5","name":"Royal-Regency-Suites-g-2.jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Royal_Regency_Suites_g_6_253d4c35de.jpg","hash":"Royal_Regency_Suites_g_6_253d4c35de","name":"Royal-Regency-Suites-g-6.jpg"}],"images":null,"characteristics_module":{"id":1301,"cta":{"id":2069,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Royal_Regency_Suites_Apartments_in_Business_Bay_0050bff49b.jpg","hash":"Royal_Regency_Suites_Apartments_in_Business_Bay_0050bff49b","name":"Royal Regency Suites Apartments in Business Bay"},"style":null,"title":"Experience Refined Living With Luxury Facilities at Royal Regency Suites Dubai","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Diverse Unit Options: Choose from studio, 1, 2, and 3-bedroom apartments at Royal Regency Suites with spacious layouts, catering to different lifestyles and preferences.</li><li>BOSCH integrated appliances: Enjoy top-tier efficiency and reliability with premium BOSCH appliances enhancing your daily living experience.</li><li>Smart Home Automation: Seamlessly control your home’s functions with advanced smart technology for ultimate convenience.</li><li>Italian Finishes: Revel in exquisite Italian craftsmanship, adding timeless elegance to every corner of your home.</li><li>Strategic location: Perfectly positioned in Business Bay with easy access to key roads and vibrant city attractions.</li><li>Unobstructed views: Savor breathtaking, uninterrupted vistas that elevate your lifestyle to new heights.</li></ul>","design_title":null},"location_tile":{"id":1302,"cta":{"id":2070,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amaz