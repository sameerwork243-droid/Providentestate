image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Selling_Point_b7ccc9cf39.jpg","hash":"Selling_Point_b7ccc9cf39","name":"Selling-Point.jpg"},"style":null,"title":"A Boutique Residential Address","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Limited Units - &nbsp;Only 47 exclusive residences, creating a controlled supply and stronger long-term value positioning.</li><li>42+ Years of Development Experience - Developed by Golden Light, the international arm of Goel Ganga Developments, with over 140 delivered projects.</li><li>Positioned in a Master-Planned Growth Corridor - Located in Dubai South, a large-scale ecosystem integrating aviation, logistics, residential, and commercial districts.</li><li>Proximity to Major Economic Drivers - Minutes from Al Maktoum International Airport expansion, Expo City, Etihad Rail Station, and Jebel Ali Free Zone.</li><li>Competitive Entry Price Point - Starting from AED 1.08M for 1-bedroom apartments, offering access to a future-focused district at an early stage.</li><li>Post-Handover Plan - A 70/30 payment plan includes staged construction payments and post-handover installments, supporting capital management strategies.</li><li>Diverse Unit Mix - Offers 1-bedroom, 2-bedroom, and larger 2-bedroom units with study, expanding rental, and end-user appeal.</li><li>Central Courtyard Design - Residences are built around a landscaped courtyard, creating a community-focused layout distinct from standard mid-rise developments.</li><li>30+ Curated Amenities - Includes rooftop pool, yoga deck, gym, cinema, jogging track, and recreational facilities designed to support tenant retention and occupancy.</li></ul>","design_title":null},"location_tile":{"id":2090,"cta":{"id":2928,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentest