_2_ae26b1a860","name":"Gallery-2.jpg"}],"images":null,"characteristics_module":{"id":2017,"cta":{"id":2847,"icon":null,"menu":null,"cta_label":"Find out more","isExternal":false,"custom_link":"#register-interest"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Selling_Point_ed3bcfaf26.jpg","hash":"Selling_Point_ed3bcfaf26","name":"Selling-Point.jpg"},"style":null,"title":"Artistry One by Select Group .. A New Canvas for Luxury Living in Dubai Design District","heading":"Unique Selling Points","bg_color":"blue","image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<ul><li>Design-Driven Architecture: Sculptural form inspired by light and movement</li><li>Canal &amp; Skyline Views: Panoramic vistas from most residences</li><li>Creative District Address: Located in Dubai’s art, fashion &amp; innovation hub</li><li>Private Duplex Penthouses: With rooftop terraces &amp; plunge pools</li><li>Wellness-Focused Amenities: Horizon pools, spa, gym &amp; ice bath facilities</li><li>Refined Interiors: Curated materials, fluid layouts &amp; floor-to-ceiling glass</li><li>Low-Density Living: Limited number of residences for exclusivity</li><li>Seamless City Access: Minutes from Downtown, DIFC &amp; major highways</li></ul>","design_title":null},"location_tile":{"id":2018,"cta":{"id":2848,"icon":null,"menu":null,"cta_label":"Get more information","isExternal":false,"custom_link":"#payment-plans"},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Map_Location_35d343da50.jpg","hash":"Map_Location_35d343da50","name":"Map-Location.jpg"},"style":null,"title":"Artistry One residences D3 .. A Destination Shaped by Design & Lifestyle","heading":"Location","bg_color":"blue","add_place":[],"image_fit":null,"img_align":"left","video_url":null,"icon_stats":[],"description":"<p>Artistry One Residences D3 is located in Dubai Design District, a visionary waterfront community dedicated to art, design, fashion, and innovation. Envisioned as a global creative destination, D3 is home to galleries, design studios, cultural venues, and lifestyle destinations that shape Dubai’s creative economy. The district features pedestrian-friendly promenades, waterfront walkways, and vibrant public spaces that encourage interaction and artistic expression. With direct access to Ras Al Khor Road, Al Ain Road, and Sheikh Zayed Road, residents enjoy seamless connectivity to Downtown Dubai, DIFC, Business Bay, and Dubai Mall. The proximity to Dubai Canal and Ras Al Khor Wildlife Sanctuary adds a natural dimension to this dynamic urban setting.</p><ul><li>5 Minutes – Downtown Duba</li><li>6 Minutes – Business Bay</li><li>7 Minutes – DIFC</li><li>12 Minutes – Dubai Creek Harbour</li><li>15 Minutes – Jumeirah Beach</li></ul>","design_title":null},"brochure":{"id":4828,"url":null,"file":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/brochure_23f0caf56a.pdf","hash":"brochure_23f0caf56a","name":"brochure"},"item":[],"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/General_Brochure_90d7160d65.png","hash":"General_Brochure_90d7160d65","name":"General"}},"video_module":{"id":3441,"thumbnail":null,"video_url":null},"floor_plans":[{"id":4589,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Floorplan_1_Bedroom_07089b5758.jpg","hash":"Floorplan_1_Bedroom_07089b5758","name":"Floorplan-1-Bedroom.jpg"},"title":"1 Bedroom Apartments","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":4590,"url":null,"area":null,"size":null,"media":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Floorplan_2_Bedroom_dca79022b0.jpg","hash":"Floorplan_2_Bedroom_dca79022b0","name":"Floorplan-2-Bedroom.jpg"},"title":"2 Bedroom Apartments","kitchen":null,"parking":null,"flooring":null,"ceiling_height":null,"starting_price":null},{"id":4591,"url":null,"area":null,"size":null,"