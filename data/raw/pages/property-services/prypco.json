e.s3.eu-west-2.amazonaws.com/i/prypco_annual_roi_ea0a1cfd3b_9a88981df8.png"},"cta":{"cta_label":"8% - 12% Expected net annual ROI","custom_link":null,"isExternal":false,"icon":null,"id":"d08cee56-5578-5fd6-9319-e2bc580a7e66","strapi_id":1587,"menu":null}},{"strapi_id":249,"description":null,"id":"99d047c7-685f-5b7f-8888-724bb72ccdb5","image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_to_invest_a3338e5f08_50ad25c0bc.jpg"},"cta":{"cta_label":"60 sec. To invest","custom_link":null,"isExternal":false,"icon":null,"id":"4632b545-dc75-5f9b-bf51-1f7ab6623cfb","strapi_id":1588,"menu":null}},{"strapi_id":250,"description":null,"id":"b1405b1f-3097-53b0-8bdb-9db45f5a3755","image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_little_invest_0252ec4875_b5a980562c.jpg"},"cta":{"cta_label":"Invest as little as AED 2000","custom_link":null,"isExternal":false,"icon":null,"id":"af156b3f-1efa-5daa-8d64-fa967c6f90b9","strapi_id":1589,"menu":null}},{"strapi_id":251,"description":null,"id":"bb310a98-8c81-57b2-9598-a058b83755f8","image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_nationalities_d06ebb5c48_e287be5c03.jpg"},"cta":{"cta_label":"200+ Nationalities eligible","custom_link":null,"isExternal":false,"icon":null,"id":"19863018-fecf-5d6e-9cf7-da2f6b7ed12f","strapi_id":1590,"menu":null}}],"heading":null},{"id":"91b0c5d1-b19b-5fc9-ae0d-8081a1b2f1ce","cta":null,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_blocks_35a6311d20_0613ef2f41.jpg"},"design_title":{"data":{"design_title":"<h3>Earn Income <span>Fast</span> Block by Block.</h3>"}},"img_align":"right","strapi_component":"modules.tile-block","strapi_id":957,"title":null,"description":{"data":{"description":"<p><span style=\"white-space:pre-wrap;\"><strong>Real Estate Crowdfunding:</strong> Small Investments for Massive Real Estate Gains! Introducing a fresh approach to investing with PRYPCO Blocks! With this innovative concept, investors can now obtain up to 31% of maximum ownership in each property. This reimagined investment strategy breaks down properties into Blocks, allowing fractional ownership of a portion of the property.</span></p><p><span style=\"white-space:pre-wrap;\">This means benefiting from the profitable Dubai real estate market without having to buy the entire property. PRYPCO by Damac presents an opportunity to engage in real estate crowdfunding, a game-changing method for new or experienced investors to participate in lucrative projects that typically require substantial capital. With PRYPCO Blocks, investors can diversify their portfolios and potentially earn significant returns.</span></p>"}},"video_url":null,"heading":null,"icon_stats":[],"bg_color":"ash","image_fit":null,"style":"multi_color"},{"id":"66da2c27-3052-5d7e-beca-7722ecdfed76","cta":{"cta_label":"Start Earning Monthly Income","custom_link":"https://prypco.com/blocks/signup?referral=4TXIP9UR5","isExternal":true,"icon":null,"id":"74709d54-c38c-5a44-86b5-777480a33a71","strapi_id":1592,"menu":null},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_laptop_d0566f0afb_fa54875844.png"},"design_title":{"data":{"design_title":"<h3>Explore <span>PRYPCO</span> blocks today</h3>"}},"img_align":"left","strapi_component":"modules.tile-block","strapi_id":958,"title":null,"description":{"data":{"description":"<p><span style=\"white-space:pre-wrap;\">And discover a new way to invest in Dubai real estate.</span></p>"}},"video_url":null,"heading":null,"icon_stats":[],"bg_color":"white","image_fit":"contain","style":"multi_color"},{"title":null,"year":null,"content":{"data":{"content":"<h3>Dubai’s Best Investment Platform<br><strong>How does </strong><span><strong>PRYPCO</strong></span><strong> Blocks work?</strong></h3>"}},"image":null,"bg_color":"light","style":"award","strapi_component":"modules.year-award","timeline":[{"text":{"data":{"text":"<p>Step: Explore</p><p><span>Discover a curated selection of properties chosen by industry experts.  </span></p>"}}},{"text":{"data":{"text":"<p>Step: Invest</p><p><span>Diversify your investment portfolio by purchasing property Blocks starting from just AED 2,000 on a fractional ownership crowdfunding platform.</span></p>"}}},{"text":{"data":{"text":"<p>Step: Profit</p><p><span>Relax and enjoy monthly income streams while witnessing your investment appreciate over time. </span></p>"}}},{"text":{"data":{"text":"<p>Step: Manage</p><p><span>Take control of your investments by deciding whether to add, retain, or withdraw them once the staking period ends. The choice is yours!</span></p>"}}}]},{"title":null,"year":null,"content":{"data":{"content":"<h3><strong>Safe Guarded Investments:</strong>&nbsp;<br><span class=\"small-1\">Regulated by DFSA</span>&nbsp;&nbsp;<br><span class=\"mini\">(Dubai Financial Services Authority)</span></h3>"}},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/prypco_dfsa_22141bee54_5ca56500e0.png"},"bg_color":"ash","style":"image","strapi_component":"modules.year-award","timeline":[]},{"id":"21e3392c-1e1b-5879-b7c6-bc95c3272822","title":"Frequently Asked Questions","strapi_id":87,"strapi_component":"modules.faq","cta_text":null,"bg_color":null,"faqs":[{"strapi_id":2289,"question":"Are PRYPCO Blocks regulated?","id":"cf6bbb9e-0a41-549c-a8ef-e74c5d413341","answer":{"data":{"answer":"<p>PRYPCO Blocks operates under the regulatory oversight of the Dubai Financial Services Authority (DFSA) and is registered with the Dubai International Financial Center (DIFC).</p>"}}},{"strapi_id":2290,"question":"How do I register for an account?","id":"dcc2474f-8ad3-5ac5-a01e-c0fbc426bd04","answer":{"data":{"answer":"<p>To create an account, you need to provide personal details and supporting documents such as your passport and proof of address for the Know Your Customer (KYC) process, as required by the DFSA.</p>"}}},{"strapi_id":2291,"question":"What is the minimum investment amount for PRYPCO Blocks?","id":"2ce9a8a9-b52b-5e9e-b3ef-763799629240","answer":{"data":{"answer":"<p>Invest in homeownership with as little as AED 2,000.&nbsp;</p>"}}},{"strapi_id":2292,"question":"What is the maximum investment limit for PRYPCO Blocks? ","id":"112ea1a8-c585-5430-abef-9e8e2216f895","answer":{"data":{"answer":"<p>Retail investors can invest up to $50,000 (AED 183,500) per calendar year. Additional verification may allow for higher investments.&nbsp;</p>"}}},{"strapi_id":2293,"question":"What are the transaction costs associated with PRYPCO? ","id":"d9c3ea48-971d-575a-9170-e7ce0a879f68","answer":{"data":{"answer":"<p>Transaction costs may include DLD transfer and registration fees, trustee fees, brokerage fees, property insurance, valuation fees, and DIFC fees, among others.&nbsp;</p>"}}},{"strapi_id":2294,"question":"How is ownership of PRYPCO properties verified? ","id":"633fc07b-a7e3-5a08-aab5-b23132dd4c7e","answer":{"data":{"answer":"<p>Investors’ ownership is legally recorded through shares in a Special Purpose Vehicle (SPV) established in the DIFC.&nbsp;</p>"}}},{"strapi_id":2295,"question":"What payment methods are accepted for deposits?","id":"183e247c-1c2e-57d6-801a-5fb20ffae646","answer":{"data":{"answer":"<p>Deposits can be made directly from your bank account to your PRYPCO wallet.&nbsp;</p>"}}},{"strapi_id":2296,"question":"How many blocks can I hold at once?","id":"b653b06e-198f-59a1-b9bb-aa93d6845779","answer":{"data":{"answer":"<p>Ownership is limited to a maximum of 31% of blocks in any property at any given time.&nbsp;</p>"}}},{"strapi_id":2297,"question":"What ROI can I expect from my investment? ","id":"6216f797-f12d-5eda-afc5-8ff555ca616c","answer":{"data":{"answer":"<p>Anticipate up to 12% annual ROI over the investment term.&nbsp;</p>"}}},{"strapi_id":2298,"question":"What if a property listing fails to meet its target amount? ","id":"685dd130-97d0-5243-8d4e-e666a4b133ab","answer":{"data":{"answer":"<p>In such cases, the investment period may be extended, or investors may receive a refund.&nbsp;</p>"}}},{"strapi_id":2299,"question":"Is there a withdrawal fee? ","id":"ef82ac78-f733-59c9-bb82-d52fda93f365","answer":{"data":{"answer":"<p>When selling fractional ownership, PRYPCO charges a withdrawal fee to cover transfer and asset maintenance costs.&nbsp;</p>"}}},{"strapi_id":2300,"question":"What happens after the investment term expires? ","id":"e40efccd-7469-505b-ac26-7b5739404021","answer":{"data":{"answer":"<p>Investors have the opportunity to vote on whether to sell the property or extend ownership for an additional six months, with the property sold at its current market value.</p>"}}}]}]}},"pageContext":{"page_id":"987c06b4-c1e7-5bdd-89a6-a16567419552"}},"staticQueryHashes":["1089302090","114448681","1247589040","1546599633","1722115342","1797776728","1852303543","1957971603","2073252141","2321620788","2424680402","2476392615","285207698","2929598853","2990965877","3432741055","3472835299","3592264445","3726810395","3783427077","4119191191","4293686711","697165605","702895677","837291995","867548045","870892561"]}