amazonaws.com/i/icon_4_5467a47a18.svg"}},{"title":"Diverse Home Loan Programs","strapi_id":14,"id":"3186517f-fc28-56dd-870d-a755b1878a66","description":"The availability of a variety of home loan programs means that clients have more options to choose from, increasing their chances of finding a mortgage that suits their specific needs.","heading":null,"icon":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/icon_5_2ac1c2091c.svg"}}]},{"id":"a122f164-270f-56e0-8021-c286e17b6880","cta":{"cta_label":"Get a free consultation","custom_link":"#Mortgage","isExternal":false,"icon":"right-arrow-white","id":"3ea384a5-32f2-5c33-8d8d-0359c71c3abc","strapi_id":1238,"menu":null},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/service_1_85e3339837.jpg"},"design_title":{"data":{"design_title":""}},"img_align":"left","strapi_component":"modules.tile-block","strapi_id":680,"title":"Our Services","description":{"data":{"description":"<p><meta charset=\"utf-8\">Explore a range of tailored mortgage solutions designed to meet your diverse needs:</p>"}},"video_url":null,"heading":null,"icon_stats":[{"text":"Resident Mortgages","strapi_id":1086,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"aa5ddd78-4dd7-536c-88a2-6be0915c7720"},{"text":"Non-Resident Mortgages ","strapi_id":1087,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"8aedfc5a-7809-5637-8e88-82bc46da1d7b"},{"text":"Commercial Finance","strapi_id":1088,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"3b198b92-d06a-5885-ae4f-2a79d0c876e8"},{"text":"Equity Release / Buyouts","strapi_id":1089,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"2003349b-1d0d-535e-a159-0dc524c4da27"}],"bg_color":null,"image_fit":null,"style":null},{"id":"7d568ba7-b1ba-536b-b2a6-344ab19bdad6","title":null,"strapi_id":44,"strapi_component":"modules.global-module","heading":null,"choose_module":"reviews_slider","bg_color":null,"cta_text":null,"design_title":{"data":{"design_title":""}}},{"id":"2213cf7e-a1b5-516c-8542-89c07cdeba93","title":"Frequently Asked Questions","strapi_id":37,"strapi_component":"modules.faq","cta_text":{"id":"c9e85a85-af4e-5b5b-9eea-3f7c567107c5","text":"Get in touch with our team and we’ll be happy to help","cta":{"cta_label":"Need more help?","custom_link":null,"isExternal":false,"icon":null,"id":"dc1747ce-e04b-5b64-82ae-b9f1ecc332d8","strapi_id":1243,"menu":null}},"bg_color":null,"faqs":[{"strapi_id":619,"question":"What is the difference between a flat rate and a reducing rate of interest?","id":"cd2401f1-83e0-58ea-aa52-47cc267c6fcd","answer":{"data":{"answer":"<p>A Flat Rate is the interest rate that remains the same throughout the mortgage repayment duration as it is calculated against the total principal amount. Meanwhile, a Reduced Interest Rate, also called a diminishing interest rate, is calculated monthly on the outstanding balance rather than the original amount. It is best to confirm with your mortgage consultant and broker in Dubai whether a flat or reduced rate has been applied.</p>"}}},{"strapi_id":620,"question":"How to calculate mortgage affordability?","id":"4bc4345e-72a1-51f2-822e-03346e408e26","answer":{"data":{"answer":"<p>Need a mortgage to buy property in Dubai? Your mortgage loan eligibility primarily depends on the bank's policies and your monthly and annual income. Some banks impose a cap on mortgages in Dubai, allowing you to borrow no more than 7 times your annual income (equivalent to 84 months), with total liability repayments not exceeding 50% of your monthly salary.</p><p>Other factors influencing mortgage affordability include age, nationality, employment type, and credit history. It is best to seek guidance from mortgage brokers in Dubai, as they can offer personalized advice tailored to your circumstances.</p>"}}},{"strapi_id":621,"question":"Why do banks require a security check when getting a mortgage?","id":"a263f284-dcd0-5f90-8131-e905a8b2fdff","answer":{"data":{"answer":"<p>The banks usually need a security check to provide a loan in the UAE. The security check safeguards the bank when the borrower fails to pay the installment. Every bank in the UAE asks for a security check as a guarantee when extending any type of credit facility, like mortgages.</p>"}}},{"strapi_id":622,"question":"What is a security check?","id":"c286f1b0-2252-512a-93ef-0ceca57fdd19","answer":{"data":{"answer":"<p>The banks usually need a security check to grant a loan in the UAE. It is a guarantee a bank requests while approving any credit. If the borrower fails to repay the debt installment according to the agreed-upon terms, the lender has the right to take possession of the property through a legal process.</p>"}}},{"strapi_id":623,"question":"Can my housing allowance be taken into account for my mortgage?","id":"6f02ab18-31a7-5478-b431-32c7d475b8fa","answer":{"data":{"answer":"<p>When you apply for a mortgage in the UAE, your housing allowance can be considered in the assessment process. For instance, if your contract or salary certificate specifies a housing allowance upon vacating company-provided accommodations, this can enhance your affordability and potentially increase the borrowing amount in certain cases.</p>"}}},{"strapi_id":624,"question":"Can my bonus be taken into account for my mortgage?","id":"40f914d2-4b44-59cf-9322-f4f073567893","answer":{"data":{"answer":"<p>Additional income from bonuses can be considered in the Dubai property mortgage application process. Guaranteed bonuses explicitly outlined in your contract or salary certificate are more likely to be accepted, although discretionary bonuses may also be considered. However, it all depends on the bank and the type of bonus you are eligible for.</p>"}}},{"strapi_id":625,"question":"What is an NOC?","id":"492cc5c2-a12c-582d-a806-db60db3004cb","answer":{"data":{"answer":"<p>Issuing a No Objection Certificate (NOC) for real estate in the UAE ensures no outstanding financial obligations. In real estate transactions, the seller of a residential or commercial property must get an NOC from the property's developer.</p><p>The document affirms that all service costs have been settled. In Dubai, you can easily obtain an eNOC through Dubai REST, the official mobile application of the Real Estate Regulatory Agency (RERA).</p>"}}},{"strapi_id":626,"question":"Is it possible to get insurance to cover my mortgage payments in the event of an accident, sickness or unemployment?","id":"766230e2-4552-5910-8ec6-9a53ef7f9bf7","answer":{"data":{"answer":"<p>Certainly, insurance is a compulsory requirement for all mortgages in the UAE. Typically, the financial institution providing the funds will ask you to get their in-house life insurance policy to secure the mortgage. This mortgage payment protection insurance is designed to cover your mortgage expenses in the event of unemployment, illness, or accident.</p>"}}},{"strapi_id":627,"question":"Can non-resident investors get mortgage loans on properties in Dubai?","id":"8b190e13-996f-5c29-aa1a-39c947a3a523","answer":{"data":{"answer":"<p>Yes. Foreign investors can get up to 50% of the property value, while residents are eligible for up to 80% of the land and construction value. However, the borrower needs to submit the required document, have the down payment ready, and meet the bank's eligibility criteria to apply for the loan.</p>"}}},{"strapi_id":628,"question":"Can I get a loan for an off-plan property in Dubai?","id":"78a22c84-91ae-5ef2-9386-e35fd7829e46","answer":{"data":{"answer":"<p>Yes, getting a loan for an off-plan property in Dubai is possible, but the maximum loan-to-value ratio for mortgages on off-plan properties in Dubai is 50%.</p>"}}},{"strapi_id":629,"question":"Are there insurance requirements for mortgages in the UAE?","id":"82ded2e1-e32f-5a23-9670-6aef6bc34844","answer":{"data":{"answer":"<p>Yes. Many lenders require property insurance to protect the property and the lender's investment. Additionally, life insurance may be recommended to cover the outstanding mortgage amount.</p>"}}},{"strapi_id":630,"question":"How long does the mortgage approval process take in Dubai?","id":"651f754b-04d6-5971-bd79-89e375910fe6","answer":{"data":{"answer":"<p>The timeline for mortgage approval varies depending on factors such as the lender's processes, documentation, and property type. It can take a few weeks to a couple of months on average.</p>"}}}]},{"id":"93282f57-21d9-5b9a-86db-5a9a5c452114","title":"Book your free  consultation today","content":{"data":{"content":"<p><meta charset=\"utf-8\"><meta charset=\"utf-8\">Navigating Dubai and UAE real estate? Trust our dedicated team for expert mortgage advice and safeguard your interests throughout the buying or refinancing journey.</p>"}},"stats":[],"form":"Mortgage","strapi_component":"modules.form-module","strapi_id":9,"show_contact":false,"cta":null,"icon_stats":[{"text":"Finance up to 79.5% of Your Property Purchase","strapi_id":1090,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"b3390ddb-2723-5f3d-9f0f-2a8e2f9abe2b"},{"text":"All-Time-Low Fixed Margin of 1.03%","strapi_id":1091,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"d3849efb-a724-5c58-9400-1de21089f9a2"},{"text":"Speedy Property Loan Approval","strapi_id":1092,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"359f7084-8ad0-515c-8dcf-6d603bb06ee1"},{"text":"Time-Low Fixed Rate of 2.99%","strapi_id":1093,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"739e0042-acfe-568e-b4b9-c42804a98160"},{"text":"Exclusive Bank-Processing Discounts for Handover Finance","strapi_id":1094,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"83287dbc-55a7-51b0-b6e4-24b2a0f0622d"},{"text":"Reduced Interest Rates","strapi_id":1095,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/check_cricle_cb53f31e5e.svg"},"id":"8b7f2ec9-22e7-5da4-9f3e-de8e48f471a6"}]}]}},"pageContext":{"page_id":"d64709dd-32df-5c47-a5e0-1d5cedaec0f7"}},"staticQueryHashes":["1089302090","114448681","1247589040","1546599633","1722115342","1797776728","1852303543","1957971603","2073252141","2321620788","2424680402","2476392615","285207698","2929598853","2990965877","3432741055","3472835299","3592264445","3726810395","3783427077","4119191191","4293686711","697165605","702895677","837291995","867548045","870892561"]}