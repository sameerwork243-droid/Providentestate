{"componentChunkName":"component---src-templates-news-detail-template-js","path":"/blog/sheikh-hamdan-approves-plan-to-turn-dubai-uni-into-free-zones/","result":{"data":{"strapiBlog":{"createdAt":"2023-09-11T07:53:42.078Z","updatedAt":"2024-06-22T14:38:10.664Z","video_url":null,"title":"Sheikh Hamdan Approves Plan to Turn Dubai Uni into Free Zones","short_description":null,"tile_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_da25bdbea9.jpg"},"team_contact":null,"strapi_id":57,"slug":"sheikh-hamdan-approves-plan-to-turn-dubai-uni-into-free-zones","publish":true,"id":"69874dab-f807-59da-8b62-586dcd4dd0a3","rank":null,"date":"March 10, 2019","category":{"strapi_json_value":[],"id":"d3cb98a5-7c05-5e86-84ff-2164e970d63d"},"banner_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_062755acd5.jpg"},"author":null,"modules":[{"id":"006cce49-d727-5194-a6f1-23831a88b423","strapi_component":"components.rich-text-block","strapi_id":103,"text":{"data":{"text":"<p>The Crown Prince of Dubai has approved a new strategy to create economic and creative free zones in the universities of UAE.</p><p>The Sheikh Hamdan bin Mohammed Al Maktoum said the plan will allow students to carry out business activities as an integrated part of their higher education.</p><p>The aim is to support students with education and research, and funding and pave way for the universities to graduate not students, but successful entrepreneurial employers.</p><p>Sheikh Hamdan said the announcement was part of the 50-Year Charter to ensure a sustained development march that will turn Dubai into the best city in the world.</p><p>He quoted. “We draw inspiration from the vision of Vice President and Prime Minister of the UAE and Ruler of Dubai His Highness Sheikh Mohammed bin Rashid Al Maktoum and the targeted future development areas that he outlined in the 50-Year Charter.</p><p>“As we approve the strategy to create economic and creative free zones in universities.</p>"}}},{"id":"4d126d16-afaa-567a-a762-0980ffb233c3","strapi_id":67,"strapi_component":"modules.ads-banner","small":true,"marketing_banner":{"title":"Invest Smart, Invest with Provident","bg_image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/high_ROI_ad_card_1_f0edde247c.jpg"},"icon":null,"cta":{"cta_label":"Contact Us","custom_link":null,"isExternal":false,"icon":null,"id":"aa8092c4-56cd-5dea-aa53-0607595a1e81","strapi_id":758,"menu":{"title":"General Enquiry","page":{"layout":"form_page","id":"4c8cd67e-65fc-5e12-bb3c-6c1e48adb07c","publish":true,"page_name":"General Enquiry","strapi_id":57},"strapi_parent":{"slug":"contact","title":"Contact","publish":true,"link_type":"internal","id":33},"link_type":"internal","slug":"general-enquiry","strapi_id":66,"id":"fac7c4b3-a6f1-55e9-ada7-8466e85fe1d2"}},"cta1":null,"description":{"data":{"description":"<p>Discover a World of Opportunities to Maximize ROI.</p>"}},"ggfx_results":[{"src_cftle":"i/high_ROI_ad_card_1_f0edde247c.jpg","transforms":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/492x/high_ROI_ad_card_1_f0edde247c.webp","transform":"492x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/1128x/high_ROI_ad_card_1_f0edde247c.webp","transform":"1128x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/492x/high_ROI_ad_card_1_f0edde247c.jpg","transform":"492x","format":"jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/1128x/high_ROI_ad_card_1_f0edde247c.jpg","transform":"1128x","format":"jpg"}]}],"heading":"Unlock High ROI's on property","publish":true,"rank":1,"strapi_id":1,"style":null}},{"id":"468043bb-a844-51d9-a10b-b900e935a20c","strapi_component":"components.rich-text-block","strapi_id":104,"text":{"data":{"text":"<p>Sheikh Hamdan highlighted the importance of supporting graduates in their quest to create progress and how that supports Dubai’s approach to become a leading global hub for entrepreneurship and investment in knowledge. The new strategy was prepared by the Dubai Future Foundation in collaboration with other government entities.</p><p>The strategy prioritises collaboration with top international research institutions and universities to achieve its goals.</p>"}}}],"ggfx_results":[{"src_cftle":"i/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_da25bdbea9.jpg","transforms":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/340x/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_da25bdbea9.webp","transform":"340x","format":"webp"}]},{"src_cftle":"i/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_062755acd5.jpg","transforms":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/696x/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_062755acd5.webp","transform":"696x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/1000x/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_062755acd5.webp","transform":"1000x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/339x/Dubai_Crown_Prince_Sheikh_Hamdan_bin_Mohammed_Al_Maktoum_062755acd5.webp","transform":"339x","format":"webp"}]}],"seo":null}},"pageContext":{"id":"69874dab-f807-59da-8b62-586dcd4dd0a3"}},"staticQueryHashes":["1722115342","1797776728","2073252141","3432741055","3472835299","3592264445","3783427077","4119191191","702895677","867548045"]}