s.global-module","heading":"PROVIDENT SUSTAINABILITY INITIATIVE","choose_module":"sustainability_initiative_slider","bg_color":null,"cta_text":null,"design_title":{"data":{"design_title":""}}},{"id":"106e1512-e23c-5c4a-9e52-4193f261f8d9","cta":{"cta_label":"Start Investing Now","custom_link":"#General_Enquiry","isExternal":false,"icon":"up-right-arrow-white","id":"3f513149-9290-549b-be88-0cd8291bb600","strapi_id":2273,"menu":null},"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/12_63e523031b.jpg"},"design_title":{"data":{"design_title":""}},"img_align":"left","strapi_component":"modules.tile-block","strapi_id":1492,"title":"How It Works","description":{"data":{"description":"<p>Sustainable real estate practices in Dubai are becoming the norm — and with a simple three-step process, you can be part of the change too.</p><ul><li><strong>Purchase a Property:</strong> Once, you buy a property with Zoya Ventures Real Estate, you automatically become part of our sustainability mission.</li><li><strong>We Plant a Tree: </strong>For every purchase, Zoya Ventures Real Estate plants a tree locally in the UAE, with satellite tracking to follow its growth.</li><li><strong>You Get a Certificate: </strong>Each client receives a personalized digital certificate as a lasting reminder of their contribution to a greener UAE.</li></ul>"}},"video_url":null,"heading":"get involved","icon_stats":[],"bg_color":null,"image_fit":null,"style":null},{"id":"6c46c1b0-cf8a-5d82-9690-dcd2866778cc","title":"Speak with our Real Estate specialists today","content":{"data":{"content":"<p>Discover the best holiday home and short or long-term rental services. Our experienced team ensures a seamless and hassle-free experience, taking care of every detail for you.</p>"}},"stats":[],"form":"General_Enquiry","strapi_component":"modules.form-module","strapi_id":26,"show_contact":true,"cta":null,"icon_stats":[]}]}},"pageContext":{"page_id":"621e677e-2af9-54c9-9cbc-37f694ee93a4"}},"st