{"componentChunkName":"component---src-templates-team-contact-tempalte-js","path":"/team/laura-adams/contact/","result":{"data":{"strapiTeam":{"services":"Valuations, Sales, Leasing","locations":"Dubai","strapi_id":31,"id":"e8aae72e-f05a-50cd-a8b3-0d4056365241","rank":10,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Laura_2a2b935cfd_7bba892524.jpg"},"slug":"laura-adams","publish":true,"phone":"+971509806722","office_phone":"+971509806722","name":"Laura Adams","experience_since":"","license":"7870","email":"laura.a@providentestate.com","designation":"Associate Partner","extra":{"profile_image":"https://storage.googleapis.com/prov-email-signatures/Laura-Adams-PFB.png"},"about":{"data":{"about":"Laura Victoria Adams, Associate Partner at Zoya Ventures Real Estate, is a highly respected professional with over two decades of experience in sales, marketing, and real estate. Beginning her career in the U.K. before relocating to Dubai in 2008, she has since become a prominent figure in the city’s property market, leading high-value transactions across off-plan, secondary sales, and large-scale portfolio management. Known for her award-winning expertise and deep market insight, Laura has held senior leadership roles including Sales Director at Zoya Ventures Real Estate, where she has guided clients ranging from high-net-worth individuals to institutional investors. Today, she is recognized not only for her ability to execute complex deals and feasibility studies from land acquisition to project completion, but also for her commitment to mentoring and empowering the next generation of real estate professionals in Dubai."}},"sale_summary":{"total_count":"7","primary_total_count":"7","total_monetary_value":33022259.17,"secondary_total_count":0,"primary_total_monetary_value":33022259.17,"secondary_total_monetary_value":0,"last_update":"08-05-26","developers":[{"name":"Al Habtoor","total_count":"3"},{"name":"Damac","total_count":"2"},{"name":"emaar","t