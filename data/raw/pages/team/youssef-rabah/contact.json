{"componentChunkName":"component---src-templates-team-contact-tempalte-js","path":"/team/youssef-rabah/contact/","result":{"data":{"strapiTeam":{"services":null,"locations":null,"strapi_id":41,"id":"45221c38-b1a6-551e-a1f1-544737a765b0","rank":16,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Youssef_Rabah_d2d9113c8a_c4889dffe6.jpg"},"slug":"youssef-rabah","publish":true,"phone":"+971 4 892 5831","office_phone":"+971 4 892 5831","name":"Youssef Rabah","experience_since":null,"license":"74237","email":"info@providentestate.com","designation":"Director - Property Management & Inspections","extra":null,"about":{"data":{"about":"<p>Youssef Rabah is the Director of Property Management &amp; Inspections at Provident Estate. He joined the company in 2021, bringing extensive expertise in residential property management and inspection services.</p><p>Accredited as a Residential Manager (ARM) from the Institute of Real Estate Management (IREM®), he leads with a commitment to safeguarding client assets through strategic oversight, operational efficiency, and a strong focus on investor and homeowner needs.</p><p>Under his leadership, the property management team continuously enhances inspection protocols and fine-tunes management strategies to ensure asset preservation and long-term value.</p><p>His scope of responsibility spans the full property lifecycle: from key handover, tenant sourcing and qualification, contract preparation and Ejari registration, to move-in coordination, inspections, and utility confirmations.</p><p>Youssef also oversees maintenance management, renewals, and vacating procedures, ensuring that every process is handled with professionalism and efficiency.</p><p>By managing every detail of day-to-day operations, Youssef ensures clients enjoy complete peace of mind while maximizing returns.</p>"}},"sale_summary":{"total_count":"0","primary_total_count":"0","total_monetary_value":0,"secondary_total_count":0,"primary_total_monetary_