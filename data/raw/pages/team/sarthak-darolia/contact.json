{"componentChunkName":"component---src-templates-team-contact-tempalte-js","path":"/team/sarthak-darolia/contact/","result":{"data":{"strapiTeam":{"services":null,"locations":"Dubai","strapi_id":835,"id":"3168ffc1-ed60-5997-b056-21fd9c18d3bf","rank":10,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Sarthak_Darolia_6adcbea557_c05cde7708.jpg"},"slug":"sarthak-darolia","publish":true,"phone":"+971 50 517 8342","office_phone":"+971 50 517 8342","name":"Sarthak Darolia","experience_since":"","license":"cmo17","email":"cmo@providentestate.com","designation":"Director - Marketing","extra":{"profile_image":null},"about":{"data":{"about":"<p>Sarthak Darolia is the Marketing Director at Zoya Ventures Real Estate, where he leads one of the most progressive in-house marketing teams in Dubai’s real estate industry. With over a decade of marketing experience and deep expertise in the Dubai property market, Sarthak focuses on building high-performance marketing ecosystems that combine strategy, technology, and storytelling to drive global investor demand.</p><p>At Zoya Ventures Real Estate, he has transformed the marketing function into a structured growth engine. He built and scaled a multidisciplinary team of over 40 marketing professionals across performance marketing, creative production, content, SEO, MarTech, and analytics. Through clear operational frameworks and integrated marketing technology, his team delivers high-impact digital campaigns, international investor roadshows, and large-scale brand initiatives connecting global investors to Dubai’s most prestigious developments.<br><br>Sarthak has collaborated with leading developers including Emaar, Ellington, and DAMAC, helping position Dubai real estate as one of the world’s most attractive investment destinations. Known for his leadership approach, Sarthak believes in building teams that outperform themselves by creating clarity, accountability, and a culture where people are empowered to think like owners.<br><br>In recognition of his contributions, he received the <strong>Marketing Excellence Award in 2024</strong> for surpassing performance targets and elevating marketing standards within the organization.<br><br>Today, his focus goes beyond campaigns. He is committed to building scalable marketing systems, developing future leaders, and continuously raising the standard of real estate marketing in Dubai.</p>"}},"sale_summary":null,"category":{"strapi_json_value":["Management"],"id":"88d24c2d-0df6-5fac-a45c-ae5ca00cbd90"},"languages":{"strapi_json_value":["English","Hindi"],"id":"4aefeca0-eacc-5f54-a527-045e4bb0757f"},"reviews":[],"bio":null,"achievements":null,"countries":null,"clients":null,"years":null,"negotiator_mapping":"17","negotiator_id":"cmo17","show_transaction":true,"imagetransforms":null,"ggfx_results":[{"src_cftle":"i/website_pic_ba9d6dc69c.jpg","transforms":[{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/480x/website_pic_ba9d6dc69c.webp","transform":"480x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/1044x/website_pic_ba9d6dc69c.webp","transform":"1044x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/324x/website_pic_ba9d6dc69c.webp","transform":"324x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/336x/website_pic_ba9d6dc69c.webp","transform":"336x","format":"webp"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/600ct350/website_pic_ba9d6dc69c.jpg","transform":"600ct350","format":"jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/324x/website_pic_ba9d6dc69c.jpg","transform":"324x","format":"jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/480x/website_pic_ba9d6dc69c.jpg","transform":"480x","format":"jpg"},{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/x/304x419/website_pic_ba9d6dc69c.webp","transform":"304x419","format":"webp"},{