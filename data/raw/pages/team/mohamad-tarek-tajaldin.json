{"componentChunkName":"component---src-templates-team-detail-template-js","path":"/team/mohamad-tarek-tajaldin/","result":{"data":{"strapiTeam":{"services":null,"locations":"Dubai","strapi_id":69,"id":"4d01d210-bda9-5932-887d-10031fac9450","rank":13,"image":{"url":"https://ggfx-providentestate.s3.eu-west-2.amazonaws.com/i/Tarek_0f930aa13d_b50bece93f.jpg"},"slug":"mohamad-tarek-tajaldin","publish":true,"phone":"+971 50 446 8547","office_phone":"+971 50 446 8547","name":"Mohamad Tarek Tajaldin","experience_since":"","license":"53703","email":"m.tajaldin@providentestate.com","designation":"Director - Secondary Sales","extra":{"profile_image":"https://providentestate.info/sig/img/Tarek-new-pfb.png"},"about":{"data":{"about":"<p>Mohamad Tarek Tajaldin is the Director Secondary Sales at Provident Estate, specializing in high-value residential transactions across Dubai’s most established villa communities. With a strong focus on the luxury secondary market, he leads strategic sales operations in sought-after areas such as The Springs, The Lakes, and Meadows, delivering tailored advisory solutions to both end users and investors.</p><p>Since joining Provident Estate in August 2023, Mohamad has been instrumental in driving secondary market performance through deep market knowledge, negotiation expertise, and a client-first approach. Known for his clear communication and results-driven leadership, he consistently supports clients through complex resale transactions with professionalism and discretion.</p><p>Mohamad is a RERA-certified real estate professional and operates within Provident’s luxury segment, offering informed guidance backed by market insight and experience. Fluent in English and Arabic, he works closely with regional and international clients seeking secure, long-term value in Dubai real estate.</p>"}},"sale_summary":{"total_count":"0","primary_total_count":"0","total_monetary_value":0,"secondary_total_count":0,"primary_total_monetary_value":0,"secondary_total